# WS11 capture-helper config (copy to .env; the launcher should export these before `npm start`).

# --- Gaiada platform (the ERP backend) ---
PLATFORM_URL=http://localhost:3004
HELPER_TENANT_ID=            # the agency tenant id (companies.id)
# Dev auth (matches platform-ui dev BFF): service token + the operator's user id.
PLATFORM_SERVICE_TOKEN=
HELPER_USER_ID=
# Prod auth: an OIDC access token instead of the two above.
# HELPER_ACCESS_TOKEN=

# --- Local recording ---
RECORDINGS_DIR=              # default: %USERPROFILE%\Gaiada\Recordings
FFMPEG_PATH=ffmpeg          # or an absolute path to ffmpeg.exe
# Run `npm run devices` to list dshow device names, then set:
AUDIO_DEVICE=               # e.g. Microphone (Realtek(R) Audio)
SYSTEM_AUDIO_DEVICE=        # optional: a loopback/Stereo Mix/VB-Cable device to also capture system audio
SCREEN_INPUT=desktop        # gdigrab source for Audio+Video

# --- Local whisper (faster-whisper-server) ---
WHISPER_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-small

# --- Google Drive (FREE personal account; run `npm run drive-token` once) ---
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=            # the shared folder recordings upload into

# --- Local control UI ---
HELPER_HOST=127.0.0.1
HELPER_PORT=7842
