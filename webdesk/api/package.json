{
  "name": "webdesk-api",
  "version": "0.0.0",
  "private": true,
  "description": "WebDesk (Zone B) NestJS api — WSK-05 key lifecycle + scoped-auth + per-tenant read quotas. See README.md.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:codegen",
    "build:codegen": "node scripts/build-codegen-bundle.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "codegen:run": "node --import tsx src/codegen/generator/run-codegen.mts",
    "codegen:gate": "node --import tsx src/codegen/generator/double-run-gate.mts",
    "codegen:gate:dist": "npm run build:codegen && node ../qa/p3-gate/double-run-gate-dist.mjs --tenants acme,globex"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/otel": "0.21.2",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "bullmq": "^5.34.5",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.7.28",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "esbuild": "0.21.5",
    "openapi-typescript": "7.13.0",
    "tsx": "4.19.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.5"
  }
}
