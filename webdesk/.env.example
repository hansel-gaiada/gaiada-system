# WebDesk (Zone B) — .env.example
#
# Copy to `.env` and fill in real values for local dev. NEVER commit `.env` (see ../.gitignore).
#
# HARD RULE (WSK-01 AC, grep-proven): this file — and this project — carry ZERO Zone A
# credentials or hostnames. Zone B does not know the ERP's real production hostname, Keycloak
# realm, or any Zone A secret; every control-channel value below is a LOCAL PLACEHOLDER for the
# control-plane auth work that lands at WSK-21/22. Do not paste the live ERP domain, a real
# Keycloak client secret, a synccert cert, or any Zone A database connection string into this
# file, ever.

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=webdesk
NODE_ENV=development

# ---------------------------------------------------------------------------
# Ports — the "webdesk dev port block" (8380-8389), chosen to avoid every published estate port:
# platform-nest :3004, platform-ui :3005, ai-gateway-go :3002, agent-runner :3006, the WSK-00
# RLS-spike Postgres :55432, and infra's local overrides (:55434 pg-bot, :56380 redis-test).
# ---------------------------------------------------------------------------
WEBDESK_PROXY_HTTP_PORT=8380
WEBDESK_PROXY_HTTPS_PORT=8443
# 8381 was the Payload port (WSK-48b: Payload is deleted).
WEBDESK_API_PORT=8382
WEBDESK_POSTGRES_PORT=8383
WEBDESK_REDIS_PORT=8384
WEBDESK_RUSTFS_API_PORT=8385
# 8386 was the MinIO console port (WSK-52: RustFS serves S3 + admin + health on the ONE port above).
WEBDESK_CLAMAV_PORT=8387
WEBDESK_OTEL_GRPC_PORT=8388
WEBDESK_OTEL_HTTP_PORT=8389

# ---------------------------------------------------------------------------
# Postgres — Zone B's OWN database. Own migration ledger (migrations/0001+), own owner/migrator/
# app role split (ALL THREE are NOSUPERUSER NOBYPASSRLS — see postgres/init-roles.sh), per design
# §04. This is a SEPARATE Postgres instance from platform-nest's — no cross-zone connection ever
# exists.
#
# POSTGRES_SUPERUSER/POSTGRES_SUPERUSER_PASSWORD are the Postgres-IMAGE's cluster-bootstrap
# identity only (used once, by docker-entrypoint-initdb.d, to create the three roles below).
# Nothing application-level ever connects with it.
# ---------------------------------------------------------------------------
POSTGRES_DB=webdesk
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser_password
POSTGRES_OWNER_USER=webdesk_owner
POSTGRES_OWNER_PASSWORD=changeme_owner_password
POSTGRES_MIGRATOR_USER=webdesk_migrator
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator_password
POSTGRES_APP_USER=webdesk_app
POSTGRES_APP_PASSWORD=changeme_app_password

# Connection strings the runner / services read. Migrations run as the MIGRATOR role (ticket
# WSK-01 AC), not the owner and not the app role — see migrations/README.md for the full role
# split and why the app role never has BYPASSRLS.
OWNER_DATABASE_URL=postgres://webdesk_owner:changeme_owner_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk
MIGRATE_DATABASE_URL=postgres://webdesk_migrator:changeme_migrator_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk
APP_DATABASE_URL=postgres://webdesk_app:changeme_app_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk

# The tenant-context GUC name every FORCE-RLS policy composes on (design §04: fail-closed, no GUC
# => zero rows). Named once here so app code and migrations agree on the literal string.
TENANT_GUC_NAME=webdesk.tenant_ctx

# ---------------------------------------------------------------------------
# Redis (BullMQ worker queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:${WEBDESK_REDIS_PORT}

# ---------------------------------------------------------------------------
# RustFS — self-hosted S3-compatible object storage (WSK-D23 fully self-hosted; WSK-D42 RustFS
# replaces MinIO). Four buckets per §07's media-path AC: media/video public, uploads PRIVATE
# (presigned-only), artifacts platform-internal. RustFS ships no `mc`: buckets, versioning, object
# lock, policies and the api's service user are made by `node scripts/storage-bootstrap.mjs`
# (run after `npm ci` in api/). The ROOT credential below is used by that script ONLY — the api
# never receives it (see STORAGE_ACCESS_KEY_ID further down).
# ---------------------------------------------------------------------------
RUSTFS_ROOT_USER=webdesk_root
RUSTFS_ROOT_PASSWORD=changeme_root_password
# From the HOST (dev). Inside the compose network the api/sentinel must use http://rustfs:9000.
STORAGE_ENDPOINT=http://localhost:${WEBDESK_RUSTFS_API_PORT}
STORAGE_BUCKET_MEDIA=media
STORAGE_BUCKET_VIDEO=video
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_ARTIFACTS=artifacts

# ---------------------------------------------------------------------------
# ClamAV (media upload scanning, WSK-07)
# ---------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# OTel — fail-soft by construction (§09/§11: OTEL_ENABLED off is a supported state). The write-
# only push target for Zone A's OTLP ingest listener is a WSK-28 deliverable and does NOT exist
# yet; leave OTEL_ENABLED=false until that listener is real. This collector is local-dev-only.
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:${WEBDESK_OTEL_GRPC_PORT}

# ---------------------------------------------------------------------------
# Control channel (§03) — PLACEHOLDERS ONLY. Real values are minted by WSK-21/22 and by owner
# action in Zone A's Keycloak; none of that exists yet and none of it belongs in this file even
# once it does (custody is platform-nest env / OpenBao, per §11's secrets-custody table). The
# issuer URL below must be a LOCAL/DEV issuer you stand up yourself — never the production ERP
# host — which is the whole point of leaving it blank by default.
# ---------------------------------------------------------------------------
CONTROL_CHANNEL_JWKS_ISSUER_URL=
WEBDESK_EVENT_SECRET=changeme_event_secret
WEBDESK_APPROVAL_ASSERTION_KEY=changeme_approval_assertion_key

# ---------------------------------------------------------------------------
# Forms mail stream (C-03) — Zone B's OWN stream key only. This project must never reference a
# Zone A mail stream (notify./auth. identities) — that is a hard containment rule (§03 egress
# table). Dev sink is Mailpit.
# ---------------------------------------------------------------------------
# --- WSK-11 . Mail (C-03). Zone B owns exactly ONE sending identity. ---
# D14 + design section 03: the forms stream ONLY. Zone A's notify./auth.gaiada.com
# use separate keys and a separate relay, and "Zone A mail never routes through
# C-03" is a locked decision. src/mail/identity.ts enforces this with a denylist and
# MailJobData carries no `from` field at all, so a queued job cannot spoof identity.
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@forms.gaiada.online
MAIL_FROM_NAME=Gaiada
# Split host/port is what the code reads. The old MAILPIT_SMTP_URL (a single URL)
# was never consumed by anything -- reconciled here per WSK-11's report.
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_QUEUE_NAME=webdesk-mail
MAIL_QUEUE_MAX_ATTEMPTS=5
MAIL_QUEUE_BACKOFF_DELAY_MS=2000
# NOTE: the real Brevo forms-stream key stays on the Staging Reopen Register.
# Do NOT put a live provider credential here (Zone A mail doctrine v3).

# --- WSK-05 · API keys + read quotas (api service) ---
# Pepper mixed into sha256(key + pepper) before storing an api_keys.key_hash.
# NEVER in git, never in the DB. Rotating this invalidates every existing key.
API_KEY_PEPPER=changeme_api_key_pepper
# Per-tenant content-read quota (noisy-neighbour protection, reassessment 2026-08-26).
# NOTE: enforcement is currently in-memory/single-process — it under-enforces the
# moment the api service runs more than one replica. Redis-backed impl is a drop-in.
WEBDESK_READ_QUOTA_PER_MIN=1000
WEBDESK_READ_QUOTA_WINDOW_MS=60000

# --- WSK-07 / WSK-52 · Media / object storage (self-hosted RustFS per WSK-D42) ---
# REQUIRED. The api's DEDICATED, least-privilege service key (object CRUD + list on the four
# buckets; it cannot PutBucketPolicy, create buckets or touch versioning/lock). The api refuses to
# boot without it and never falls back to RUSTFS_ROOT_*; compose refuses to resolve without it.
# `node scripts/storage-bootstrap.mjs` creates this user from exactly these two values
# (secret >= 8 chars). Pick your own values; they must differ from RUSTFS_ROOT_USER.
STORAGE_ACCESS_KEY_ID=webdesk_api
STORAGE_SECRET_ACCESS_KEY=changeme_api_secret_key
# Optional backup-writer key (policy `webdesk-backup`: put/get/list on the backups bucket ONLY),
# used by ops/scripts/webdesk-backup-local.sh and wd-backup-sentinel.sh. Created by the bootstrap
# when both are set.
WEBDESK_BACKUP_ACCESS_KEY_ID=
WEBDESK_BACKUP_SECRET_ACCESS_KEY=
# Optional anonymous prefix-scoped public read, "bucket:prefix,bucket:prefix" (WSK-07 configured
# none; default = none; a whole-bucket grant is rejected).
WEBDESK_STORAGE_PUBLIC_READ=
WEBDESK_MEDIA_MAX_UPLOAD_BYTES=26214400
WEBDESK_TENANT_STORAGE_QUOTA_BYTES=5368709120
WEBDESK_MEDIA_PRESIGN_TTL_SECONDS=300
# imgproxy — on-the-fly transforms (§04: pre-baked variants age badly).
IMGPROXY_URL=http://imgproxy:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- WSK-12 . Zone B -> Zone A signed fact webhooks ---
# The n8n bridge trigger URL. EMPTY = fail-soft no-op: nothing is emitted and no
# form submission is ever affected. WEBDESK_EVENT_SECRET (above) signs the payload.
WEBDESK_ZONEB_BRIDGE_URL=
WEBDESK_ZONEB_ORIGIN_SITE=webdesk
WEBDESK_ZONEB_EVENT_TIMEOUT_MS=5000
WEBDESK_ZONEB_EVENTS_ENABLED=true

# --- WSK-22 . Control-channel auth, layers 1-3 (design section 03) ---
# The ONE authenticated path from Zone A into Zone B. Placeholders EMPTY on purpose:
# a value here is a committed secret. Zone A is the only holder of control credentials.
# (WEBDESK_APPROVAL_ASSERTION_KEY, layer 4, is already defined above.)
#
# Layer 1 - mTLS. Client cert issued by the synccert internal CA (sync-engine-go/cmd/synccert).
# Zone B holds only the CA public + its own server cert, so it can never impersonate the ERP.
#
# THE CA IS A MULTI-LINE PEM — mount it as a FILE and point WEBDESK_CONTROL_MTLS_CA_FILE at the
# path (see docker-compose.aicenter.yml / docker-compose.sumopod.yml for the read-only bind
# mount). Fixed 2026-09-01 after a production crash loop: `docker compose`'s `env_file` parser
# mangles a quoted multi-line value DIFFERENTLY across compose versions — one host got an empty
# string, another got a truncated first-line-only value that looked "set" but was never a usable
# CA. WEBDESK_CONTROL_MTLS_CA_PEM (inline, below) is kept ONLY as a fallback for environments that
# cannot mount a file; the app rejects a truncated value from EITHER source loudly at boot rather
# than silently accepting it (see real-control-channel-authenticator.ts's loadPinnedCaPem).
WEBDESK_CONTROL_MTLS_CA_FILE=
WEBDESK_CONTROL_MTLS_CA_PEM=
WEBDESK_CONTROL_MTLS_ALLOWED_CN=
# Layer 2 - Keycloak client-credentials, verified OFFLINE against the PUBLIC issuer JWKS.
# The crux: verification needs NO Zone A credential, because JWKS is public key material.
# OWNER ACTION OUTSTANDING: the `webdesk-control` Keycloak client does not exist yet, so no
# token can genuinely verify against the real issuer's private key.
WEBDESK_CONTROL_OIDC_ISSUER=
WEBDESK_CONTROL_OIDC_JWKS_URI=
WEBDESK_CONTROL_OIDC_AUDIENCE=

# --- WSK-63a . Control-channel host plumbing (design write-plane section 11) ---
# The shared secret between the host-nginx vhost `control.webdesk.internal` and the Caddy proxy.
# nginx adds it as X-Webdesk-Control-Gate after verifying the client cert; Caddy routes /control/*
# to the api only when it matches (and fails CLOSED when this is empty). Generate 64 hex chars:
#   openssl rand -hex 32
# HEX ONLY - it is embedded in a Caddy CEL expression and an nginx string, so quotes would break both.
# Set it in `.env` (read by the proxy service - it is NOT an api var and must not go in .env.control)
# and render the SAME value into the nginx vhost with envsubst. Rotate both together.
WEBDESK_CONTROL_GATE_SECRET=

# --- WSK-40 . Editorial assertion verification (design write-plane section 5, ruling WSK-D39) ---
# Every content write carries x-webdesk-editorial-assertion: a 60 s Ed25519 JWS the ERP signs for
# exactly that command and its arguments. WebDesk only VERIFIES: it holds the PUBLIC key set, as a
# FILE (never inline), and never a signing key. Mount it read-only and point this at the path (see
# docker-compose.aicenter.yml). Unset or absent -> content writes answer 503
# editorial-keys-not-configured; present but truncated / non-Ed25519 / carrying a private "d" ->
# the api refuses to boot. Consumed jtis live in the queue store (REDIS_URL, keys wd:edjti:*);
# if that store is down, writes fail closed with 503 editorial-assertion-store-unavailable.
# Generate / rotate with platform-nest/scripts/webdesk-editorial-keygen.mjs per
# infra/runbooks/webdesk-editorial-keys.md. Public material, but still not committed: set it on the box.
WEBDESK_EDITORIAL_JWKS_FILE=

# --- WSK-37 . Per-tenant outbound webhooks (client CRMs) ---
# THE FIRST CLIENT-CONTROLLED EGRESS DESTINATION in this design. Every other row in the
# section-03 egress table names an operator-chosen host; this one is a URL the client picks.
# That is why ssrf-guard.ts re-validates on EVERY delivery attempt and EVERY redirect hop
# (DNS rebinding and mid-delivery redirects are both real), HTTPS-only, with the private /
# loopback / link-local / CGNAT / cloud-metadata ranges denied for both address families.
#
# Signing secret storage is ENCRYPTED (AES-256-GCM), not hashed. A signing secret cannot be
# hashed the way API_KEY_PEPPER hashes api_keys: HMAC needs the original bytes back, and a
# one-way hash by definition cannot return them. Same custody model though -- Zone B env only,
# never in the database, never in git. A DB-only compromise yields nothing usable.
TENANT_WEBHOOK_SECRET_PEPPER=
TENANT_WEBHOOK_QUEUE_NAME=webdesk-tenant-webhooks
TENANT_WEBHOOK_MAX_ATTEMPTS=5
TENANT_WEBHOOK_BACKOFF_DELAY_MS=2000
TENANT_WEBHOOK_REQUEST_TIMEOUT_MS=10000
TENANT_WEBHOOK_MAX_REDIRECTS=3
TENANT_WEBHOOK_MAX_PAYLOAD_BYTES=262144
# TENANT_WEBHOOK_SSRF_TEST_ALLOWLIST is TEST-ONLY and must never be set in a real environment:
# it exists so the suite can point a webhook at a local sink. Setting it in prod disables the
# SSRF guard for the listed hosts.

# --- WSK-28 . Zone B ops baseline ---
# See infra/runbooks/webdesk-zoneb-*.md for the full design behind every var in this block.

# CDN-bypass gate (design §11a). Shared secret Cloudflare is expected to inject as the
# X-Webdesk-Edge-Verify header on every request it forwards to this origin (an Origin/Transform
# Rule configured IN Cloudflare, not in this repo). Empty = DEV-ONLY FAIL-SOFT: the Caddyfile's
# CDN-bypass matcher on /media/* is unconditionally false when this is unset, so local dev
# (no Cloudflare in front) is unaffected — see webdesk/proxy/Caddyfile's own comment and
# webdesk/ops/scripts/check-cdn-bypass.mjs. MUST be set to a real random value before any box
# sits behind a real Cloudflare zone, or the CDN-bypass property (§11a: "a media path that
# bypasses the CDN is a defect") is not actually enforced.
WEBDESK_EDGE_VERIFY_SECRET=

# Backups (design §11, WSK-D23 pull-model). Zone B holds these for its LOCAL side only -- see
# infra/runbooks/webdesk-zoneb-backups.md §1 for why none of these are, or ever become, a
# credential for the offsite backup TARGET.
WEBDESK_BACKUP_BUCKET=backups
WEBDESK_BACKUP_SENTINEL_FILE=/var/lib/webdesk-backups/.last-run
WD_BACKUP_MAX_AGE_HOURS=26
WD_BACKUP_SENTINEL_INTERVAL_SECONDS=3600
# Dead-man's-switch ping + alert transports for wd-backup-sentinel.sh -- same two-transport
# pattern as infra/scripts/restore-drill.sh. Empty = the sentinel still runs and logs to stdout,
# it just has nowhere to page; see the script's own header.
WD_BACKUP_DEADMANSSWITCH_URL=
WD_BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
WD_BACKUP_ALERT_CHAT_ID=
WD_BACKUP_ALERT_EMAIL_TO=

# Status page (design: infra/runbooks/webdesk-zoneb-status-page.md). Public, no secrets --
# reports only this Zone B instance's own component health, never Zone A data.
WEBDESK_STATUS_REFRESH_SECONDS=30

# OTel export to the (proposed, not-yet-applied) Zone A write-only listener -- see
# infra/runbooks/webdesk-zoneb-otel.md §4. Leave both empty/false until that listener is real;
# OTEL_ENABLED=false already makes the whole OTel path fail-soft on its own (unchanged by this
# ticket), this is a SECOND, independent gate so the local dev-sink collector (webdesk/otel/) can
# keep running without also flipping on the real Zone A push.
OTEL_EXPORTER_OTLP_HEADERS=
WEBDESK_OTEL_ZONEA_PUSH_ENABLED=false
