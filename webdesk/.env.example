# WebDesk (Zone B) — .env.example
#
# Copy to `.env` and fill in real values for local dev. NEVER commit `.env` (see ../.gitignore).
#
# HARD RULE (WSK-01 AC, grep-proven): this file — and this project — carry ZERO Zone A
# credentials or hostnames. Zone B does not know the ERP's real production hostname, Keycloak
# realm, or any Zone A secret; every control-channel value below is a LOCAL PLACEHOLDER for the
# control-plane auth work that lands at WSK-21/22. Do not paste the live ERP domain, a real
# Keycloak client secret, a synccert cert, or any Zone A database connection string into this
# file, ever.

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=webdesk
NODE_ENV=development

# ---------------------------------------------------------------------------
# Ports — the "webdesk dev port block" (8380-8389), chosen to avoid every published estate port:
# platform-nest :3004, platform-ui :3005, ai-gateway-go :3002, agent-runner :3006, the WSK-00
# RLS-spike Postgres :55432, and infra's local overrides (:55434 pg-bot, :56380 redis-test).
# ---------------------------------------------------------------------------
WEBDESK_PROXY_HTTP_PORT=8380
WEBDESK_PROXY_HTTPS_PORT=8443
WEBDESK_PAYLOAD_PORT=8381
WEBDESK_API_PORT=8382
WEBDESK_POSTGRES_PORT=8383
WEBDESK_REDIS_PORT=8384
WEBDESK_MINIO_API_PORT=8385
WEBDESK_MINIO_CONSOLE_PORT=8386
WEBDESK_CLAMAV_PORT=8387
WEBDESK_OTEL_GRPC_PORT=8388
WEBDESK_OTEL_HTTP_PORT=8389

# ---------------------------------------------------------------------------
# Postgres — Zone B's OWN database. Own migration ledger (migrations/0001+), own owner/migrator/
# app role split (ALL THREE are NOSUPERUSER NOBYPASSRLS — see postgres/init-roles.sh), per design
# §04. This is a SEPARATE Postgres instance from platform-nest's — no cross-zone connection ever
# exists.
#
# POSTGRES_SUPERUSER/POSTGRES_SUPERUSER_PASSWORD are the Postgres-IMAGE's cluster-bootstrap
# identity only (used once, by docker-entrypoint-initdb.d, to create the three roles below).
# Nothing application-level ever connects with it.
# ---------------------------------------------------------------------------
POSTGRES_DB=webdesk
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser_password
POSTGRES_OWNER_USER=webdesk_owner
POSTGRES_OWNER_PASSWORD=changeme_owner_password
POSTGRES_MIGRATOR_USER=webdesk_migrator
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator_password
POSTGRES_APP_USER=webdesk_app
POSTGRES_APP_PASSWORD=changeme_app_password

# Connection strings the runner / services read. Migrations run as the MIGRATOR role (ticket
# WSK-01 AC), not the owner and not the app role — see migrations/README.md for the full role
# split and why the app role never has BYPASSRLS.
OWNER_DATABASE_URL=postgres://webdesk_owner:changeme_owner_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk
MIGRATE_DATABASE_URL=postgres://webdesk_migrator:changeme_migrator_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk
APP_DATABASE_URL=postgres://webdesk_app:changeme_app_password@localhost:${WEBDESK_POSTGRES_PORT}/webdesk

# The tenant-context GUC name every FORCE-RLS policy composes on (design §04: fail-closed, no GUC
# => zero rows). Named once here so app code and migrations agree on the literal string.
TENANT_GUC_NAME=webdesk.tenant_ctx

# ---------------------------------------------------------------------------
# Redis (BullMQ worker queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:${WEBDESK_REDIS_PORT}

# ---------------------------------------------------------------------------
# MinIO — self-hosted object storage (WSK-D23: fully self-hosted, no R2/NAS credential in Zone B
# for now). Four buckets per §07's media-path AC: media/video public, uploads PRIVATE
# (presigned-only), artifacts platform-internal.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=webdesk_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_ENDPOINT=http://localhost:${WEBDESK_MINIO_API_PORT}
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_VIDEO=video
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_ARTIFACTS=artifacts

# ---------------------------------------------------------------------------
# Payload 3 (content engine) — vendored/rebranded at WSK-02; stub here.
# ---------------------------------------------------------------------------
PAYLOAD_SECRET=changeme_payload_secret
PAYLOAD_TELEMETRY_DISABLED=1
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:${WEBDESK_PAYLOAD_PORT}

# ---------------------------------------------------------------------------
# ClamAV (media upload scanning, WSK-07)
# ---------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---------------------------------------------------------------------------
# OTel — fail-soft by construction (§09/§11: OTEL_ENABLED off is a supported state). The write-
# only push target for Zone A's OTLP ingest listener is a WSK-28 deliverable and does NOT exist
# yet; leave OTEL_ENABLED=false until that listener is real. This collector is local-dev-only.
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:${WEBDESK_OTEL_GRPC_PORT}

# ---------------------------------------------------------------------------
# Control channel (§03) — PLACEHOLDERS ONLY. Real values are minted by WSK-21/22 and by owner
# action in Zone A's Keycloak; none of that exists yet and none of it belongs in this file even
# once it does (custody is platform-nest env / OpenBao, per §11's secrets-custody table). The
# issuer URL below must be a LOCAL/DEV issuer you stand up yourself — never the production ERP
# host — which is the whole point of leaving it blank by default.
# ---------------------------------------------------------------------------
CONTROL_CHANNEL_JWKS_ISSUER_URL=
WEBDESK_EVENT_SECRET=changeme_event_secret
WEBDESK_APPROVAL_ASSERTION_KEY=changeme_approval_assertion_key

# ---------------------------------------------------------------------------
# Forms mail stream (C-03) — Zone B's OWN stream key only. This project must never reference a
# Zone A mail stream (notify./auth. identities) — that is a hard containment rule (§03 egress
# table). Dev sink is Mailpit.
# ---------------------------------------------------------------------------
MAIL_FROM_ADDRESS=forms@example.invalid
MAIL_PROVIDER=mailpit
MAILPIT_SMTP_URL=smtp://mailpit:1025

# --- WSK-05 · API keys + read quotas (api service) ---
# Pepper mixed into sha256(key + pepper) before storing an api_keys.key_hash.
# NEVER in git, never in the DB. Rotating this invalidates every existing key.
API_KEY_PEPPER=changeme_api_key_pepper
# Per-tenant content-read quota (noisy-neighbour protection, reassessment 2026-08-26).
# NOTE: enforcement is currently in-memory/single-process — it under-enforces the
# moment the api service runs more than one replica. Redis-backed impl is a drop-in.
WEBDESK_READ_QUOTA_PER_MIN=1000
WEBDESK_READ_QUOTA_WINDOW_MS=60000

# --- WSK-02 · Payload listeners (two processes, on purpose) ---
# INTERNAL: admin panel + Payload's raw collection REST. Bound to localhost; the
# public Caddy vhost must NEVER forward here (WSK-D20 / design D-5).
WEBDESK_PAYLOAD_INTERNAL_PORT=8381
# PUBLIC gateway: the only Payload-side process the public vhost may reach.
# Serves /healthz and (once WSK-06 lands) /v1. Denies /admin, /api/graphql, /api/*.
WEBDESK_PAYLOAD_PUBLIC_PORT=8384
# Dev schema push DISABLES row security and drops RLS policies while leaving
# relforcerowsecurity=true — fail-OPEN and invisible (WSK-00 FINDINGS addendum).
# BOTH flags are required, and never in production. Leave unset.
PAYLOAD_ALLOW_PUSH=
PAYLOAD_ALLOW_PUSH_I_UNDERSTAND_THIS_DISABLES_RLS=
