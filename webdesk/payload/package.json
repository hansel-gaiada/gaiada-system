{
  "name": "webdesk-payload",
  "private": true,
  "version": "0.0.0",
  "description": "WSK-02 - Payload 3 vendored + rebranded for Zone B (webdesk). NOT the WSK-00 spike: this is the real service directory. See README.md for the internal/public listener split and the dev-push safety rule.",
  "type": "module",
  "scripts": {
    "dev:internal": "next dev -p ${PAYLOAD_INTERNAL_PORT:-3100}",
    "start:internal": "next start -p ${PAYLOAD_INTERNAL_PORT:-3100}",
    "build": "next build",
    "gateway": "node src/public-gateway.mjs",
    "setup-schema": "node --import tsx scripts/setup-schema.mjs",
    "test:lockdown": "node test/lockdown.test.mjs",
    "test:boot": "node --import tsx test/boot-local-api.test.mjs && node --import tsx test/boot-rest-admin.test.mjs",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "init:prod": "payload migrate && node src/reapply-tenant-rls.mjs && node ../scripts/check-rls-integrity.mjs"
  },
  "dependencies": {
    "payload": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "next": "15.4.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "graphql": "16.9.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/node": "^22.0.0"
  }
}
