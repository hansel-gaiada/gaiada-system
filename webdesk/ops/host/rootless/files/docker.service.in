# ~@USER@/.config/systemd/user/docker.service (M4 F6, WSK-D73), rendered by install-rootless.sh from
# webdesk/ops/host/rootless/files/docker.service.in. It is the unit dockerd-rootless-setuptool.sh writes
# (docker-ce-rootless-extras 29.7.0, RootlessKit 3.0.2), with every WebDesk choice made explicit instead of
# defaulted (plan §2.2/§2.3):
#   NET=slirp4netns, PORT_DRIVER=builtin  Debian-supported (bookworm main), sandboxed + seccomp'd, no SUID helper
#   DETACH_NETNS=false                    dockerd and every container stay inside RootlessKit's netns. With the
#                                         default (true) dockerd runs in the HOST netns and, since Docker 29.5,
#                                         `docker run --net=host` shares the host's netns.
#   DISABLE_HOST_LOOPBACK=true            10.0.2.2 never reaches the host's 127.0.0.1
#   SLIRP4NETNS_SANDBOX/SECCOMP=true      fail to start rather than silently run slirp4netns unhardened ("auto")
# This file lives in the daemon user's home, so it is CONFIGURATION, not a boundary: a process running as that
# user can rewrite it. The boundaries are root's: the OUTPUT guard, the slice envelope, the subuid range.
[Unit]
Description=Docker Application Container Engine (Rootless, WebDesk)
Documentation=https://docs.docker.com/go/rootless/
Requires=dbus.socket
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Environment=PATH=/usr/bin:/sbin:/usr/sbin:/bin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_MTU=65520
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_DISABLE_HOST_LOOPBACK=true
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_SLIRP4NETNS_SANDBOX=true
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_SLIRP4NETNS_SECCOMP=true
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_DETACH_NETNS=false
# Fail closed: without the egress guard's marker (root-owned, on /run) the daemon does not start at all.
ExecStartPre=/usr/bin/test -e /run/webdesk-rootless-guard/@USER@.active
ExecStart=/usr/bin/dockerd-rootless.sh
# The deploy user reaches this daemon as itself, as it reached the rootful one through the docker group.
ExecStartPost=/usr/local/lib/webdesk-rootless/grant-socket.sh @OPERATOR@ %t
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
