# WebDesk Zone B — nginx vhost for helios (WSK-28, owner ruling 2026-08-27)
#
# Install as /etc/nginx/sites-available/<HOSTNAME>.conf and symlink into sites-enabled.
# Substitute: __HOSTNAME__ (e.g. webdesk.gaiada.online) and __PROXY_PORT__ (default 8380).
#
# =================================================================================================
# READ THIS BEFORE TOUCHING NGINX ON HELIOS
# =================================================================================================
# helios serves 23 live third-party client sites from this same nginx. The ONLY safe sequence is:
#
#   1. write ONLY the STAGE 1 block below into sites-available/<HOSTNAME>.conf
#   2. symlink it into sites-enabled
#   3. `nginx -t`          <-- MUST pass. If it fails, REMOVE THE SYMLINK before doing anything
#                              else. A broken config plus a reload takes down all 23 client sites.
#   4. `systemctl reload nginx`   (reload, never restart — reload keeps existing connections)
#   5. `certbot --nginx -d <HOSTNAME>` — certbot writes the TLS server block ITSELF
#   6. copy the STAGE 2 `location /` body over whatever certbot generated, then `nginx -t` again
#   7. `systemctl reload nginx`, verify, then verify again from OFF the box
#
# ⚠ THE TWO-STAGE SPLIT IS NOT STYLE — the single-file version CANNOT WORK. A server block naming
# `ssl_certificate /etc/letsencrypt/live/<HOST>/fullchain.pem` fails `nginx -t` outright while that
# file does not exist ("cannot load certificate ... no such file"), and certbot cannot create it
# until an HTTP-01 challenge can be served, which needs a passing config and a reload first. Ship
# both blocks at once and step 3 fails on a box hosting 23 client sites. Verified by running
# `nginx -t` against both forms in a throwaway container.
#
# Never run `nginx -s reload` without a passing `nginx -t` first, and never edit nginx.conf or any
# other vhost. This file is additive by construction.
#
# =================================================================================================
# WHY THIS PROXIES TO 127.0.0.1 AND NOT A CONTAINER NAME
# =================================================================================================
# nginx runs on the host, outside Docker. The Zone B stack publishes exactly ONE port, bound to
# 127.0.0.1 (see webdesk/docker-compose.helios.yml — every other service, including Postgres,
# Redis and MinIO, publishes nothing at all). So the loopback port is the entire seam between the
# host and Zone B, which is the point: nothing else on this box, and nothing on the internet, can
# reach Zone B's datastores.
#
# What Zone B serves on that port, verified end-to-end locally before this file was written:
#   /v1/*     -> the Payload PUBLIC gateway (a process importing neither next nor payload)
#   /forms/*  -> the api
#   /media/*  -> the api, behind the CDN-bypass gate
#   /healthz  -> Caddy itself
#   /admin*, /api/*, /control/*  -> 404 at Caddy. NOT routed anywhere. (design D-5 / WSK-D20)
#
# Note what is deliberately NOT here: no `-admin` hostname of any kind. The pilot CMS already on
# delphi publishes `pilot-fullstack-cms-admin.gaiada.online` to the open internet; WebDesk's admin
# panel is reachable only from inside the Docker network, i.e. over SSH with a tunnel.

# =================================================================================================
# STAGE 1 — install this ALONE first. Passes `nginx -t` with no certificate present.
# =================================================================================================
server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__;

    # certbot writes here; everything else is redirected. Keep this BEFORE the redirect.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# =================================================================================================
# STAGE 2 — only AFTER `certbot --nginx -d __HOSTNAME__` has issued the cert and written its own
# TLS block. Reconcile certbot's output with the settings below rather than pasting this verbatim;
# the parts that matter are client_max_body_size, the X-Webdesk-Edge-Verify passthrough, and
# proxy_buffering off.
# =================================================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __HOSTNAME__;

    # TLS: reuse the same certbot setup the 23 existing sites already use. Run
    #   certbot --nginx -d __HOSTNAME__
    # AFTER the A record exists and AFTER `nginx -t` passes with the port-80 block above, and it
    # will fill these two lines in itself. Do not hand-manage certs on this box.
    ssl_certificate     /etc/letsencrypt/live/__HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOSTNAME__/privkey.pem;

    # A public content API. Bodies are form submissions and media, so keep the limit modest and
    # let the api enforce the real per-tenant ceilings (WEBDESK_FORMS_MAX_* / WEBDESK_MEDIA_*).
    client_max_body_size 32m;

    # Zone B is internet-facing; do not advertise what it runs.
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    access_log /var/log/nginx/__HOSTNAME__.access.log;
    error_log  /var/log/nginx/__HOSTNAME__.error.log;

    location / {
        proxy_pass http://127.0.0.1:__PROXY_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The CDN-bypass gate inside Caddy reads this header. It must pass through UNMODIFIED —
        # if nginx strips or rewrites it, the gate sees a mismatch and 403s every media request,
        # or (worse, if the secret is unset) silently allows everything. Do not "clean" it.
        proxy_set_header X-Webdesk-Edge-Verify $http_x_webdesk_edge_verify;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # No buffering of media/artifact streams through nginx's disk cache.
        proxy_buffering off;
    }
}
