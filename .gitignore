# Dependencies / build output (all components)
node_modules/
dist/
.next/
*.tsbuildinfo
*.log

# Secrets — real env files never leave the machine (.env.example is the template)
.env
.env.local
.env.tmp
.env.*.local
# Operator credential notes / local secret scratch files. BOTH sides of a 2026-08-03 merge added this
# independently, which is itself the signal: anything matching *.local.md is a working copy of real
# secrets (logins, API keys, reset runbooks). Before this, CREDENTIALS.local.md sat untracked but NOT
# ignored in a shared working tree, so any `git add -A` would have committed it verbatim. Patterns, not
# just the one filename, because the next such file will be called something slightly different.
CREDENTIALS.local.md
*.local.md
*.secret
.secrets/

# Agent isolation worktrees + local agent state. These live INSIDE the repo, so an unqualified
# `git add -A` in any session would otherwise sweep an entire second checkout into a commit —
# and this repo is worked by several concurrent sessions that do exactly that.
.claude/
