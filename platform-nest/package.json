{
  "name": "gaiada-platform-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Gaiada Platform core — NestJS port of the Fastify v1 core (spec-locked backend, WS1). Contract-identical; the 86 platform tests are the parity oracle.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "seed:agency": "node dist/seed/agency.js",
    "seed:personas": "node dist/seed/personas.js",
    "seed:departments": "node dist/seed/departments.js",
    "seed:automation": "node dist/seed/automation.js",
    "iam:backfill": "node dist/seed/iam-phase2-backfill.js",
    "seed:claude-seats": "node dist/seed/claude-seats.js",
    "seed:search": "node dist/seed/search.js",
    "seed:portal-clients": "node dist/seed/portal-clients.js",
    "test": "vitest run",
    "test:mail-corpus": "vitest run src/mail",
    "test:iam-chain-alignment": "vitest run src/rbac/cerbos-catalog-alignment.test.ts src/rbac/permission-groups-catalog-parity.test.ts src/rbac/iam-07b-chain-meta.test.ts",
    "mail:replay-inbound": "node scripts/replay-inbound.mjs",
    "typecheck": "tsc --noEmit",
    "lint:withtenants": "node scripts/lint-withtenants.mjs",
    "lint:migration-rls": "node scripts/lint-migration-rls.mjs",
    "lint:migration-names": "node scripts/lint-migration-names.mjs",
    "lint:postiz-deps": "node scripts/lint-postiz-deps.mjs",
    "gen:role-bundles": "node scripts/generate-role-bundles.mjs",
    "gen:scope-constrained-roles": "node scripts/generate-scope-constrained-roles.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.28",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.5"
  }
}
