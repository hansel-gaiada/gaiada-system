# Copy to .env.

HOST=0.0.0.0
PLATFORM_PORT=3004

# Postgres — connect as a NON-superuser NOBYPASSRLS role (superusers bypass RLS).
DATABASE_URL=

# Service token surfaces (mcp-hub, bot, n8n) must present (fail-closed when empty).
PLATFORM_SERVICE_TOKEN=

# This site's id (recorded on every row; sync engine uses it later)
ORIGIN_SITE=main

# Tests only: a DISPOSABLE database (dropped + remigrated every run), superuser URL
DATABASE_URL_TEST=

# Auth mode (5b): dev (x-user-id header, local/tests) | oidc (verified IdP JWT required)
AUTH_MODE=dev
OIDC_ISSUER=http://localhost:8080/realms/gaiada
OIDC_JWKS_URI=http://localhost:8080/realms/gaiada/protocol/openid-connect/certs
OIDC_AUDIENCE=gaiada-platform

# Cerbos policy decision point (5b.4). Platform authorizes every request against it.
# NOTE: run the Cerbos container with published ports (-p 3592:3592 -p 3593:3593) — a
# portless container makes every authorization call fail (connection refused).
CERBOS_URL=http://localhost:3592

# File storage (5c.4). Local-first backend now; point at a persistent, backed-up volume in
# real deployments. An object store is the target-state swap behind the StorageBackend seam.
FILES_DIR=./data/files

# WD-04 (Web Dev Phase 1): in-ERP audio upload -> server-side transcription. Calls the whisper
# container's OpenAI-compatible /v1/audio/transcriptions endpoint DIRECTLY (never via
# ai-gateway-go) — meeting-length audio would exceed the gateway's ~2.5-min per-call timeout.
# Empty WHISPER_URL => POST .../meetings/recordings/:id/audio refuses cleanly (no phantom host).
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_TIMEOUT_MS=1200000
# Size caps for an uploaded meeting recording (bytes). Audio default 200MB, video 500MB — video
# gets its own, larger cap because the same meeting is an order of magnitude bigger with a picture.
# Enforced PER KIND in the handler: @fastify/multipart can register only one fileSize for the whole
# app, so main.ts registers MAX(audio, video) as the outer ceiling and the real cap is applied once
# the upload's type/extension has been classified.
# Do NOT raise these to multi-GB without changing the upload path first: it buffers the whole file in
# memory and the whisper call makes a second copy, so peak RSS is roughly 2x the file size.
MEETING_AUDIO_MAX_BYTES=209715200
MEETING_VIDEO_MAX_BYTES=524288000

# ── Search-marketing / SEO module (SM-04 stop-loss, SM-05 driver, SM-06 flags) ─────────────────────
# KEYLESS IS SUPPORTED: leave DATAFORSEO_* empty and the paid driver is simply not registered —
# every paid capability then fails closed, while the $0 pillars (crawler audits, keyword
# clustering, AI drafts) keep working. Fill these in only after the shared deposit is funded.
#
# ONE server-side credential pair against ONE shared deposit pool — never per-client keys.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# standard (~5 min queue, $0.0006/SERP) | live (immediate, $0.002 — 3.3x). Keep 'standard'.
DATAFORSEO_QUEUE=standard
DATAFORSEO_TIMEOUT_MS=20000

# Provider-selection cascade tail. Per-engagement tool_scope.provider overrides both.
SEARCH_DEFAULT_PROVIDER=dataforseo
SEARCH_TENANT_DEFAULT_PROVIDER=

# "live" (default) registers real vendor drivers per their own credentials below. "simulate"
# registers SM-33's synthetic dataforseo/semrush/ahrefs drivers INSTEAD, so dev/staging can demo the
# department at $0 real spend without empty tables. Only the exact string "simulate" opts in — a
# typo falls back to "live", same typo-safety principle as DATAFORSEO_QUEUE above.
SEARCH_PROVIDER_MODE=live

# SM-26 (addendum §A12.6): the Google Ads WRITE mode, DELIBERATELY INDEPENDENT of the data-vendor mode
# above. SEARCH_PROVIDER_MODE describes where keyword/SERP DATA comes from; this describes whether an
# approved change proposal is actually pushed to a client's live ad account. They must be settable
# separately, because "simulated data" and "simulated ad writes" are different risks: pushing real ad
# changes derived from synthetic keyword data is the one cross-product that is FORBIDDEN outright, and
# a live executor refuses such proposals with no override flag — the plan gets regenerated instead.
#
# "simulate" (the default, and the default on a typo — same typo-safety principle as above) always uses
# the simulator EVEN IF a live executor is registered. "live" requires a registered live executor and
# REFUSES TO BOOT without one: an unfinished deployment must fail at startup, not at the moment a
# client's approved ad change silently does nothing after its one-shot approval has been spent.
SEARCH_ADS_WRITE_MODE=simulate

# SM-48 (tracker §6s): a PLATFORM-LEVEL, tenant-agnostic list of portfolio domains (comma-separated)
# folded into simulate mode's SERP candidate pool ONLY — never read by the live drivers. Fixes the
# gap where a simulated rank-pull always returned position: null because the simulator had no notion
# of any tenant's tracked property. Deliberately NOT per-tenant/per-call: search_data_cache is shared,
# no-RLS market data (D-4), so a tenant-specific domain must never enter it. Unset (default) => today's
# simulated SERP, byte for byte.
SEARCH_SIMULATION_PORTFOLIO_DOMAINS=

# Semrush Analytics API v3 (SM-34). `key` query-param auth (Semrush's own model, not Basic auth).
# Empty SEMRUSH_API_KEY => driver not registered, INDEPENDENTLY of DataForSEO's/Ahrefs's own checks.
SEMRUSH_API_KEY=
SEMRUSH_BASE_URL=https://api.semrush.com
SEMRUSH_DATABASE=us
SEMRUSH_TIMEOUT_MS=20000
# Design addendum §A3.3/§A7 OQ-9 (BINDING): the team's Semrush plan/allowance are UNVERIFIED from
# this desk — read them off the Semrush account console. BOTH must be a positive number, or the
# driver does NOT register even with SEMRUSH_API_KEY set (an unset rate must never silently become
# $0, which would disarm the budget stop-loss for every Semrush op — design addendum §A3.3/B1).
SEMRUSH_MONTHLY_PLAN_PRICE_USD=
SEMRUSH_MONTHLY_UNIT_ALLOWANCE=

# Ahrefs API v3 (SM-35). Bearer-token auth. Empty AHREFS_API_KEY => driver not registered,
# INDEPENDENTLY of DataForSEO's/Semrush's own checks.
AHREFS_API_KEY=
AHREFS_BASE_URL=https://api.ahrefs.com/v3
AHREFS_COUNTRY=us
AHREFS_TIMEOUT_MS=20000
# SERP Overview needs a pre-existing Ahrefs Rank Tracker project id (Ahrefs requires it; we don't
# provision Rank Tracker projects). Unset => the 'serp' capability refuses cleanly, no network call.
AHREFS_RANK_TRACKER_PROJECT_ID=
# Design addendum §A3.3/§A7 OQ-10 (BINDING): whether the team's Ahrefs plan even includes API v3 at
# all is UNVERIFIED from this desk — read it off the Ahrefs account console. BOTH must be a positive
# number, or the driver does NOT register even with AHREFS_API_KEY set (same B1 rule as Semrush).
AHREFS_MONTHLY_API_TIER_PRICE_USD=
AHREFS_MONTHLY_UNIT_ALLOWANCE=

# Spend stop-loss. Order: engagement provider_budget_usd -> tenant -> global. The engagement cap
# lives on the row (per-client, set in the console); these two are the deploy-wide ceilings.
# SEARCH_TENANT_MONTHLY_CAP_USD unset => that tier is skipped (engagement + global still enforced).
SEARCH_GLOBAL_MONTHLY_CAP_USD=150
SEARCH_TENANT_MONTHLY_CAP_USD=
# Fraction of a cap at which a warning threshold event fires (0.8 = 80%).
SEARCH_BUDGET_WARN_RATIO=0.8

# Per-pillar kill switches — an incident brake, not a rollout gate. Default ON; set to 0 to
# refuse every paid pull for that pillar platform-wide, ahead of any per-engagement config.
SEARCH_PILLAR_SEO=1
SEARCH_PILLAR_SEM=1
SEARCH_PILLAR_GEO=1

# SM-54 — the platform-side pull scheduler (modules/search/pull-scheduler.ts), OFF BY DEFAULT.
# This is a MONEY CONTROL, not a performance flag: the question it answers is "does this
# environment spend vendor money unattended". It is the one loop in the platform that can spend
# without a human in the request path, so it must stay dark in dev, in test, and in any fresh
# deployment where nobody has set per-engagement budgets yet. Same env-flag shape as
# PM_BURNDOWN_SNAPSHOT_ENABLED / SERVICE_ASSIGNMENTS_ENABLED. "1" or "true" enables it.
SEARCH_SCHEDULER_ENABLED=
# How often due-ness is RE-ASKED, not how often a pull happens — cadence is derived per engagement
# from tool_scope vs its last capture-or-attempt, so shrinking this cannot increase spend, only
# reduce how late a due pull fires. Default 3600000 (1h); refuses <=1000ms at boot.
SEARCH_SCHEDULER_INTERVAL_MS=

# SM-56 — the shared secret authenticating the Standard-queue COLLECT edge
# (POST /api/:tenantId/modules/search/rank-pulls/callback), presented by the relay as the
# `x-gaiada-search-callback-secret` header and compared in constant time. Must match the value in
# automation/.env (same name). Deliberately NOT N8N_BRIDGE_SECRET: a relay carrying an external
# vendor's postback is a different trust boundary from internal event traffic.
#
# FAIL-CLOSED: while this is EMPTY (the default) that route refuses EVERY request with a 401. Nothing
# else in the platform is affected — no other route reads it. "Unset" means an unfinished deployment,
# never permission.
#
# ⚠️ Read at the point of use in modules/search/search.controller.ts rather than parsed in config.ts,
# because config.ts was owned by a concurrent ticket when SM-56 landed. The follow-up is to move it to
# `config.search.callbackSecret` — a pure move, no behaviour change (see that function's doc comment).
SEARCH_CALLBACK_SECRET=

# ── SM-25a / SM-51 · GOOGLE CLIENT-ACCOUNT SURFACES (Search Console / GA4 / Ads) ────────────────────
# Design addendum §A12 (binding): a THIRD EGRESS CLASS — client-private, $0-API-billed, per-client
# OAuth. These do NOT ride SearchDataProvider/dispatchProviderOp (no dollars to meter), never touch
# search_data_cache (no-RLS shared market data by design — a client's own Search Console rows there
# would be a cross-tenant leak by construction), and write only tenant-scoped FORCE-RLS tables. The
# bounding resource is Google QUOTA, not spend.
#
# FAIL-CLOSED: while CLIENT_ID / CLIENT_SECRET / REDIRECT_URI are empty, every Google entry point
# refuses with an honest 503 (`google_oauth_not_configured`). Tokens also require INTEGRATION_TOKEN_KEY
# (the vault key, above) — it seals tokens at rest AND derives the OAuth `state` signature, so an unset
# vault key means no Google flow can even start. "Unset" means unfinished deployment, never permission.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ONE exactly-registered redirect URI, deliberately tenant-agnostic: real Google permits no wildcards,
# so a per-tenant callback path would need one registration per company. The tenant travels inside the
# HMAC-signed `state` instead.
GOOGLE_OAUTH_REDIRECT_URI=
#
# Endpoint seams. Defaults are Google's own hosts; leave them alone in any real deployment.
# GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GOOGLE_SEARCH_CONSOLE_BASE_URL=https://searchconsole.googleapis.com
# GOOGLE_ANALYTICS_DATA_BASE_URL=https://analyticsdata.googleapis.com
# GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
# GOOGLE_ADS_API_VERSION=v18
#
# Ads-only. UNVERIFIED plan/approval facts (SM-41G): a developer token must be APPROVED by Google
# before it works at all, and login-customer-id/MCC semantics cannot be rehearsed locally.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
#
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600      # how long an in-flight authorize request stays redeemable
# GOOGLE_OAUTH_REFRESH_SKEW_SECONDS=120   # refresh this far ahead of the stored expiry
# GOOGLE_OAUTH_TIMEOUT_MS=15000
#
# ⚠️ LOCAL DEV AGAINST KEYCLOAK (§A12.3, the machine path). The endpoint seams above may be pointed at
# the local Keycloak `google-dev` realm client to exercise the FULL authorization-code + PKCE round
# trip, refresh with rotation, and RFC-7009 revocation against a real issuer:
#   1. infra/compose/keycloak/provision-google-dev-client.py   (idempotent; prints the values to paste)
#   2. set SEARCH_ALLOW_PRIVATE_GOOGLE_ENDPOINT=1
# Step 2 is REQUIRED and deliberately so: in live mode the boot guard REFUSES to start when a Google
# endpoint names a private/loopback/internal host (§A10.4 extended to Google by §A12.3), because such a
# stack would seal credential-vault rows and stamp them `linked` from an issuer that is not Google.
# Separate from SEARCH_ALLOW_PRIVATE_VENDOR_BASEURL on purpose: fabricated market data and a
# misrepresented client credential are different risks. Like its sibling it is a LEXICAL accident
# guard, not an authz control.
SEARCH_ALLOW_PRIVATE_GOOGLE_ENDPOINT=
#
# WHAT NO LOCAL SETUP CAN PROVE — SM-41G's staging clauses, stated here because this is where an
# operator forms expectations: Google's consent screen, incremental consent and scope-grant semantics;
# refresh-token longevity under the OAuth app's publish status (a Testing-mode app's refresh tokens
# expire in 7 DAYS); Google-side revocation; quota/429 behaviour; the Ads developer-token approval and
# MCC/login-customer-id semantics; and whether real Google accepts our serialized requests at all.
# A green local harness is a validated client of our own model of Google — NOT a validated integration.

# ── TR-21 (tracker/reporting §6.3) · PDF export via the report-renderer sidecar ─────────────────────
# Where this platform reaches the report-renderer sidecar (TR-19) to render a PDF export.
REPORT_RENDERER_URL=http://localhost:3007
# The SAME shared bearer token report-renderer's own auth.ts checks (report-renderer/.env's
# RENDERER_TOKEN) — one shared secret, not two independently rotated ones. openssl rand -hex 16.
RENDERER_TOKEN=
# MUST be byte-identical to report-renderer's own PLATFORM_UI_INTERNAL_URL — this platform builds
# the sidecar's `url` ({PLATFORM_UI_INTERNAL_URL}/print/reports/{jobToken}) from this same value,
# and the sidecar's SSRF guard (isAllowedRenderUrl) compares the URL it is handed against ITS copy.
PLATFORM_UI_INTERNAL_URL=http://localhost:3005
# Any of the three above left empty => the pdf export endpoint refuses with an honest 503 rather
# than half-attempting the sidecar call (config.ts's fail-soft convention).
REPORT_RENDERER_TIMEOUT_MS=30000

# ── Knowledge (D9 RAG) ingestion · the two corpora the vector store is filled from ─────────────────
# Where the WS8 knowledge service lives. Without BOTH of these, ingestion is inert and every
# knowledge.search returns nothing (the store is only ever written through this service — D9).
KNOWLEDGE_URL=http://localhost:3005
KNOWLEDGE_SERVICE_TOKEN=
# Master switch. Deliberately OFF by default: enabling it starts crawling and embedding, which is
# real gateway load, so it must be a decision rather than a side effect of booting a new environment.
KNOWLEDGE_INGEST_ENABLED=0
# How often a full sweep runs (public corpus + every company's ERP corpus). Default 6h.
KNOWLEDGE_INGEST_INTERVAL_MS=21600000
#
# PUBLIC tier — world-readable company knowledge (audience='public'), retrievable with NO identity,
# which is how a lead or client with no ERP account can be answered.
# THIS IS AN EGRESS ALLOWLIST, NOT A HINT: the fetcher refuses any URL — seed, sitemap entry,
# discovered link, or redirect target — whose host is not listed here. Read the SSRF note at the top
# of src/modules/knowledge/ingest/web-source.ts before adding a host you do not own.
KNOWLEDGE_PUBLIC_SITES=https://gaiada.com
# The company row that OWNS the public chunks. It does NOT restrict who may read them — that is what
# audience='public' means. Required: ingestion refuses rather than guessing an owning company.
KNOWLEDGE_PUBLIC_TENANT_ID=
KNOWLEDGE_PUBLIC_MAX_PAGES=150
#
# INTERNAL tier — employee-only knowledge (projects, tasks, clients, deliverables, meeting
# transcripts, PM docs, sealed reports, files, org structure and people), readable only by members of
# the owning company. Empty = every active company; set a CSV of company ids to narrow it.
KNOWLEDGE_INTERNAL_TENANT_IDS=
# Index attached-file CONTENTS as well as their metadata. Text and spreadsheet formats only —
# PDF/DOCX are metadata-only by design (see src/modules/knowledge/ingest/file-text.ts).
KNOWLEDGE_INDEX_FILE_CONTENTS=1

# ── Keycloak ADMIN access (W0-3) — provisions client-portal contact accounts on invite acceptance ──
# FAIL-CLOSED: any of these four unset => every provisioning entry point throws an honest 503 and no
# client contact can be given an account. Nothing half-creates.
#
# The client MUST be a confidential SERVICE-ACCOUNT client holding realm-management:manage-users
# (+ view-users). `gaiada-provisioner` exists on the gaiada realm for exactly this. Do NOT use the
# master-realm admin, and do NOT reuse gaiada-platform (whose audience the API itself trusts) — a
# leaked provisioner secret should be able to manage users and nothing else. Verified boundary: it
# cannot create clients and cannot map realm-admin onto a user it created (both 403).
#
# baseUrl is the realm ROOT with NO /realms suffix. NOTE this deployment serves Keycloak under /idp,
# not /auth: internally http://keycloak:8080/idp.
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_ADMIN_REALM=gaiada
KEYCLOAK_ADMIN_CLIENT_ID=gaiada-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── MAIL-04 (design docs/superpowers/specs/2026-08-04-zone-a-mail-design.md v3 §4.1/§10/§12) ───────
# `src/mail/` is core infra (A1), not a ModuleContract module — no per-tenant enable gate.
#
# Master gate. 0 (default) = the whole module is DARK: the sender loop never starts and
# enqueueMail() no-ops instead of writing a row — zero side effects, not merely "nothing sent".
MAIL_ENABLED=0
MAIL_SENDER_INTERVAL_MS=15000
# Per-stream transport facts. A8: `relay`|`brevo` is an OPERATOR FAILOVER FLIP, not automatic — set
# the *_BREVO_* facts and flip *_TRANSPORT when the relay is down, no code change either way.
# Local dev (no Mailpit running): leave *_RELAY_HOST empty and the smtp adapter falls back to the
# dev-log adapter (nothing sent, logged instead). Against a local Mailpit: RELAY_HOST=localhost,
# RELAY_PORT=1025 (whatever port you published it on), empty user/password (Mailpit is authless —
# provider.ts's TLS rule allows plaintext ONLY when both are empty). gda-aicenter's compose default
# already points both streams at `mailpit:1025` — see infra/compose/docker-compose.vps.yml.
MAIL_STREAM_NOTIFY_TRANSPORT=relay
MAIL_STREAM_NOTIFY_RELAY_HOST=
MAIL_STREAM_NOTIFY_RELAY_PORT=587
MAIL_STREAM_NOTIFY_RELAY_USER=
MAIL_STREAM_NOTIFY_RELAY_PASSWORD=
MAIL_STREAM_NOTIFY_BREVO_HOST=
MAIL_STREAM_NOTIFY_BREVO_PORT=587
MAIL_STREAM_NOTIFY_BREVO_USER=
MAIL_STREAM_NOTIFY_BREVO_PASSWORD=
# A12: leave empty to keep the compiled `*.gaiada.invalid` FROM default — a deployment that forgets
# to set the real identity then sends from an address that can never resolve, never a real-looking
# one nobody configured. Staging sets the real notify-subdomain identity here (design §15 R1).
MAIL_STREAM_NOTIFY_FROM=
MAIL_STREAM_AUTH_TRANSPORT=relay
MAIL_STREAM_AUTH_RELAY_HOST=
MAIL_STREAM_AUTH_RELAY_PORT=587
MAIL_STREAM_AUTH_RELAY_USER=
MAIL_STREAM_AUTH_RELAY_PASSWORD=
MAIL_STREAM_AUTH_BREVO_HOST=
MAIL_STREAM_AUTH_BREVO_PORT=587
MAIL_STREAM_AUTH_BREVO_USER=
MAIL_STREAM_AUTH_BREVO_PASSWORD=
MAIL_STREAM_AUTH_FROM=
# VERP inbound reply-token host half (`reply+<token>@<this>`); empty keeps the compiled
# `notify.gaiada.invalid` default.
MAIL_REPLY_DOMAIN=
# The deep-link base every approval/warning template's `href` is built from (A12 — brand new; no
# ERP public-base config existed before this). Empty keeps the compiled `https://erp.gaiada.invalid`
# default (obviously fake, never resolves) — set the real public ERP URL for a live deployment.
MAIL_LINK_BASE_URL=
# Provider delivery-event webhook + inbound-intake auth. Random locals in dev (design §12: the dev
# stage has no external secrets at all); empty = both surfaces fail-closed. openssl rand -hex 24.
MAIL_WEBHOOK_TOKEN=
MAIL_INBOUND_TOKEN=
MAIL_INBOUND_MAX_BYTES=5242880
# 'off' (default) or 'clamav' (MAIL-14) — attachment downloads stay admin-only whenever this is 'off'.
MAIL_INBOUND_SCAN=off
# MAIL-13 (design §7.6). Brevo does NOT sign webhooks — its documented options are basic-auth-in-URL,
# a token header, or custom headers — so MAIL_INBOUND_TOKEN above is the wall that is real today. This
# key enables an ADDITIONAL HMAC-SHA256 verifier over the RAW request bytes
# (x-gaiada-mail-inbound-signature: t=<unix>,v1=<hex>). Empty (default) = signature verification is
# reported OFF rather than pretending to have passed; set = a valid signature is REQUIRED.
MAIL_INBOUND_SIGNING_KEY=
MAIL_INBOUND_SIGNATURE_TOLERANCE_S=300
# Per-attachment + count caps. An attachment over either cap is DROPPED while the message still
# threads (a human's written reply must not be discarded because of an attachment); only
# MAIL_INBOUND_MAX_BYTES above refuses a whole delivery.
MAIL_INBOUND_MAX_ATTACHMENT_BYTES=2097152
MAIL_INBOUND_MAX_ATTACHMENTS=10
# Per-source flood control at intake, applied AFTER authentication. 0 disables. In-process and
# therefore per-instance by design (there is no Redis dependency in src/mail/ — design A2).
MAIL_INBOUND_RATE_PER_MIN=60
# MAIL-14's clamd, reachable only when the compose `scan` profile is up. Unreachable => every
# attachment stays scanStatus='pending' => downloads refused (fail-closed on exposure).
MAIL_CLAMAV_HOST=clamav
MAIL_CLAMAV_PORT=3310
MAIL_CLAMAV_TIMEOUT_MS=20000
# §9/§15 R5 — stays 0 for real users until the staging SLO gate closes.
MAIL_MAGIC_LINKS_ENABLED=0
# MAIL-10 — TTL + the two rate-limit dimensions the ticket AC names verbatim.
MAIL_MAGIC_LINK_TTL_SECONDS=900
MAIL_MAGIC_LINK_RATE_PER_ADDRESS_HOUR=3
MAIL_MAGIC_LINK_RATE_PER_IP_HOUR=10
# MAIL-24 (Finding 3) — trusted-proxy allowlist for the x-forwarded-for read on
# POST /auth/magic-link. Empty (default) = trust nothing = always key the per-IP rate limit on
# the raw socket address. Comma-separated exact IPs of a real reverse-proxy hop; do NOT set this
# unless one genuinely sits in front of this service.
MAIL_MAGIC_LINK_TRUSTED_PROXIES=

# ── D14-04 / D14-03 — automation-write execution grant ───────────────────────────────────────────
# ONE shared HMAC secret between platform-nest (which mints a single-use grant inside the approval's
# pending -> executing claim) and mcp-hub (which verifies it and lifts ONLY its impact-suspend gate
# for that exact tool + args). Value format and claims are fixed by
# docs/superpowers/plans/2026-08-05-d14-and-assistant-tickets.md §1.
# Empty on either side ⇒ every grant is REJECTED (fail closed): an approved medium/high-impact
# automation write simply keeps suspending. That failure is silent by design, so after setting this
# check mcp-hub's GET /admin/info -> policy.executionGrantConfigured === true.
# Must ALSO be listed in both services' `environment:` blocks in
# infra/compose/docker-compose.vps.yml — a value in .env alone does nothing.
#   openssl rand -hex 32
APPROVAL_GRANT_SECRET=

# ── D14-03 — the executor's own reachability (mcp-hub) ───────────────────────────────────────────
# The approval EXECUTOR (src/core/approval-execute.ts) re-drives an approved automation/agent write
# by calling mcp-hub's `POST /mcp` tool endpoint as the ORIGINAL filing principal. It therefore needs
# BOTH of these in addition to APPROVAL_GRANT_SECRET above; they are the same two values the
# admin/systems console already probes the hub with (config.services.hub), so most deployments have
# them set — they are listed here because without them an approved row lands
# execution_status='failed' with `not_configured`, which is easy to misread as a broken contract.
# Already wired in the platform service's `environment:` block in infra/compose/docker-compose.vps.yml.
HUB_URL=http://localhost:3003
HUB_SERVICE_TOKEN=
# The elevated hub token (mcp-hub design §2). The platform presents THIS on OBO tool calls when set,
# which is what lets the agent re-drive clear approvals.resolveExecute's `verified` floor. Unset ⇒
# falls back to HUB_SERVICE_TOKEN, i.e. the call still happens and is denied at the assurance gate.
HUB_ASSURANCE_TOKEN=

# ── ASST-06 — the assistant's send->stream engine ────────────────────────────────────────────────
# Reuses GATEWAY_URL/GATEWAY_TOKEN below (the ONE place ai-gateway-go's endpoint is wired from env,
# same binding admin-systems.controller.ts and search's providers/gateway-client.ts read) for the
# actual `POST /complete(/stream)` calls. These two are assistant-specific TUNABLES only.
# Server-side idle timeout (ms): no token/event from ai-gateway-go for this long -> the stream
# aborts the upstream call and surfaces a visible `error` event (errorKind 'idle_timeout') instead
# of hanging. Deliberately shorter than the platform-ui client-side 120s idle timeout (ASST-07).
ASSISTANT_STREAM_IDLE_TIMEOUT_MS=60000
# Context-assembly char budget for the recent-messages window kept verbatim in the prompt sent to
# the gateway (~4 chars/token approximation — the gateway's stream wire carries no usage field to
# calibrate against). Overflow beyond this triggers compaction v1 (fold the oldest excerpt into
# the thread's rolling summary via one POST /complete call).
ASSISTANT_CONTEXT_CHAR_BUDGET=12000

# ai-gateway-go endpoint (already referenced above by ASST-06, D14-03's hub-client note, and the
# admin/systems console + search module's own gateway client) — listed here once, at the point a
# fresh .env.example reader will first need it.
