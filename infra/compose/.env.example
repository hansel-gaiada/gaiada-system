# Copy to .env next to docker-compose.vps.yml and fill in (openssl rand -hex 16 for tokens).

# Release pinning — every first-party service runs the SIGNED GHCR image for this tag; the box
# never compiles (docs/blueprints/deployment-strategy.md). CI sets these per deploy; set them
# here only for manual/break-glass runs. Use docker-compose.build.yml to build from source.
GAIADA_TAG=latest
GHCR_OWNER=hansel-gaiada

# Postgres — one superuser + per-service owner(migrator) & runtime roles (DB topology plan
# 2026-07-15). Each service connects as its restricted *_app role; migrations run as *_owner.
POSTGRES_SUPER_PASSWORD=
PLATFORM_OWNER_PASSWORD=
PLATFORM_APP_PASSWORD=
SYNC_APP_PASSWORD=
KNOWLEDGE_OWNER_PASSWORD=
KNOWLEDGE_APP_PASSWORD=
# Third-party self-managed DBs on the core instance (Keycloak, n8n).
KEYCLOAK_DB_PASSWORD=
N8N_DB_PASSWORD=
# Bot roles — used by the ISOLATED pg-bot instance (its PII/crypto-shred store).
BOT_OWNER_PASSWORD=
BOT_APP_PASSWORD=

# Bot <-> WAHA webhook shared secret (fail-closed)
WEBHOOK_SECRET=
# WAHA REST API key + dashboard password
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=

# AI Gateway (the ONLY holder of provider keys)
GATEWAY_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Local model server on the VPS (blank = disabled; cloud/echo only)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# OpenAI-compatible cloud brain (e.g. Ollama Cloud). Set BASE_URL+API_KEY to route text-completion
# through it first (LLM_CHAIN below). Blank = disabled, chain falls through to ollama/gemini/claude.
#   OPENAI_BASE_URL=https://ollama.com/v1
#   OPENAI_MODEL=deepseek-v4-flash   # returns clean content; glm-5.2/kimi-k2.7-code are reasoning
#                                    # models that need a large OPENAI_MAX_TOKENS or reply empty.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
# Vision model for image media (image/* only; audio/PDF fail over to whisper/gemini). On Ollama
# Cloud qwen3.5 accepts images, glm-5.2 does not. Leave blank to disable openai image handling.
OPENAI_VISION_MODEL=qwen3.5:397b
OPENAI_MAX_TOKENS=1024
# Provider order for text completion + media. Leave default to prefer the OpenAI-compatible brain,
# then local Ollama / whisper, then cloud. Unset providers are auto-skipped.
# ASST-15/16: to make the per-thread brain-picker's "hermes" option actually route to
# hermes-gateway's NEW named provider (as opposed to the older GATEWAY_TOPOLOGY_MODE=site
# central-forward path below), "hermes" must be a MEMBER of this list — chain.RunWithHint only
# reorders a provider already present here; an unmatched hint silently falls through to the
# normal first-in-order provider. Appending it LAST (e.g. openai,ollama,gemini,claude,hermes) means
# unhinted callers on deployments that don't set HERMES_URL see no behaviour change at all.
LLM_CHAIN=openai,ollama,gemini,claude
MEDIA_CHAIN=openai,whisper,gemini
GATEWAY_DAILY_CALL_CAP=2000
# hermes-gateway as a named gateway provider (ai-gateway-go/internal/providers/hermes.go). Blank
# URL = provider unavailable, fail-soft. On gda-aicenter-style hostdata deployments (compose file
# `docker-compose.hostdata.yml` layered in), hermes-gateway is the ONE non-dockerized service —
# systemd on the host, bound 0.0.0.0:3009 — so the ai-gateway container needs the host-routable
# http://host.docker.internal:3009, which resolves there because the hostdata overlay's `x-hostgw`
# anchor already adds `extra_hosts: host.docker.internal:host-gateway` to the ai-gateway service.
# Without that overlay (plain docker-compose.vps.yml on Linux, no host-data split), this name will
# NOT resolve unless the same extra_hosts entry is added to ai-gateway directly.
# HERMES_MODEL is NOT this gateway picking a model — it only reports whatever hermes-gateway
# itself is configured with (that process's own HERMES_MODEL), threaded through for the response
# wire's `meta` field. Leave blank unless you know what hermes-gateway is running.
HERMES_URL=
HERMES_MODEL=
# The bearer hermes-gateway requires. LEAVE EMPTY unless the shim has its own secret: empty falls
# back to GATEWAY_TOKEN, which is the single key hermes-gateway's /etc/gaiada/hermes-gateway.env
# defines. Before 2026-08-06 this provider sent NO Authorization header, so it 401'd on every
# call and the chain silently failed over to central-forward — which reached the same Hermes, so
# the only symptom was a "served by" badge that never said Hermes.
HERMES_TOKEN=

# Gateway daily-call cap already above. Whisper transcription model + model-assisted DLP:
WHISPER_MODEL=Systran/faster-whisper-small
# Local-Ollama DLP classifier — enable ONLY where OLLAMA_URL is reachable (else it 503s /complete).
DLP_CLASSIFIER_ENABLED=false

# MCP hub service token
HUB_SERVICE_TOKEN=

# MCP hub ASSURANCE token (mcp-hub design §2, 2026-08-06) — a SECOND, DIFFERENT secret from the one
# above. Callers presenting it may have their OBO envelope elevated to `verified` assurance when the
# platform also vouches for that identity; callers presenting HUB_SERVICE_TOKEN are capped at `low`.
# Passed through to exactly four services: platform, agent-runner, mcp-hub, mcp-hub-central.
# Leave EMPTY and nothing elevates (fail-closed) — but then every `minAssurance: "verified"` tool,
# including D14-14's approvals.resolveExecute, denies and the agent-write half of D14 stays inert.
# Do NOT reuse HUB_SERVICE_TOKEN's value here: sharing them hands the chat surfaces the elevated
# tier and deletes the whole point of having two tokens. Generate separately (openssl rand -hex 32).
HUB_ASSURANCE_TOKEN=

# Platform service token (surfaces/hub present this to the platform API)
PLATFORM_SERVICE_TOKEN=

# Knowledge service token (WS8 derived store)
KNOWLEDGE_SERVICE_TOKEN=

# Agent runner service token (WS8 goal queue; openssl rand -hex 16)
AGENT_RUNNER_TOKEN=

# T6 (ASST-23) — the provider the D13 write gate sees for agent write capability.
# Compose already DEFAULTS this to `openai`, so leaving it blank here is safe and is the intended
# steady state; set it only to enroll a different certified provider.
#
# Why it exists at all: the runner resolves `AGENT_SERVING_PROVIDER ?? lastProvider() ?? "echo"`, and
# `echo` is not in task-filer's evaledProviders, so D13 strips its write tools and the assistant
# quietly stops being able to propose a write — no error, no log, and every local test still green.
# Changing it to a provider the eval suite has NOT certified re-arms exactly that silent failure.
AGENT_SERVING_PROVIDER=

# Platform-UI session cookie secret (REQUIRED — compose aborts if unset). openssl rand -hex 32
UI_SESSION_SECRET=

# report-renderer sidecar (TR-19, tracker/reporting §6.3) — the only image in the estate carrying
# Chromium. openssl rand -hex 16. Shared bearer token; never logged, never given to platform-ui.
# The SAME value is also read by platform-nest (TR-21's pdf export call) — one shared secret.
RENDERER_TOKEN=
# Origin this sidecar is allowed to render (SSRF guard — see report-renderer/src/auth.ts). Must
# match platform-ui's internal, network-reachable origin; default matches the compose service name.
# Read by BOTH report-renderer (its own SSRF check) and platform-nest (TR-21 builds the sidecar's
# `url` from this same value) — keep them byte-identical.
PLATFORM_UI_INTERNAL_URL=http://platform-ui:3005
# TR-21 — where platform-nest reaches the report-renderer sidecar to render a PDF export. Default
# matches the compose service name; empty (or RENDERER_TOKEN/PLATFORM_UI_INTERNAL_URL empty) makes
# the pdf export endpoint refuse with an honest 503 rather than half-attempting the call.
REPORT_RENDERER_URL=http://report-renderer:3007

# Keycloak admin (5b) + platform auth mode (dev until the realm+MFA are set up, then oidc)
KEYCLOAK_ADMIN_PASSWORD=
PLATFORM_AUTH_MODE=dev

# MAIL-03 — Keycloak realm SMTP. Defaults point at the Mailpit dev sink (mail-dev profile);
# these are read by the keycloak service's environment: block AND by
# infra/compose/keycloak/configure-smtp.sh (realm-import does NOT substitute env placeholders —
# see docs/runbooks/idp-keycloak.md, ex-Q-V6). Staging swaps these to a real relay per §15 R1/R8.
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@auth.gaiada.invalid
KC_SMTP_FROM_DISPLAY_NAME="Gaiada Auth (dev)"
KC_SMTP_AUTH=false
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false

# Telegram (long-polling; leave empty to disable)
TELEGRAM_BOT_TOKEN=

# Bot admin routes (blank = disabled) + digest delivery
ADMIN_TOKEN=
MANAGEMENT_GROUP_ID=
POST_TO_GROUPS=false
# Note: the group registry (groups.yaml) now lives in the bot-data volume after first boot,
# seeded from the committed ./groups.yaml file. See compose env GROUPS_FILE / GROUPS_SEED_FILE.
# Media worker concurrency (per-worker parallel media jobs)
MEDIA_WORKER_CONCURRENCY=2

# Admin/Systems console → bot admin probe. Set to the bot's ADMIN_TOKEN above to enable it.
BOT_ADMIN_TOKEN=

# Automation (the separate gaiada-automation n8n stack). Set only if n8n is reachable from
# this compose network. AUTOMATION_API_KEY is an n8n Public-API key → the Systems→Automation
# console lists real workflows + last-run.
# NOTE: the n8n console being published at https://erp.gaiada.online/n8n/ does NOT change
# these. In-cluster callers keep using compose DNS at http://n8n:5678, with no /n8n prefix
# (that prefix exists only for the browser-facing editor). Pointing these at the public URL
# would route platform->nginx->n8n through the basic-auth gate and 401 every forwarded event
# — silently, since the bridge acks 4xx as "delivered".
AUTOMATION_URL=
AUTOMATION_API_KEY=
# ...and the one place the PUBLIC url IS wanted: the console's "Open in n8n" link, which a browser
# has to follow. It was previously derived from AUTOMATION_URL, producing a button pointing at
# http://n8n:5678 — a hostname that exists only inside this network. Set it to the browser-facing
# editor origin (gda-aicenter: https://erp.gaiada.online/n8n/, matching N8N_EDITOR_BASE_URL in
# automation/.env). Leave empty and the UI hides the button instead of offering a dead link.
AUTOMATION_PUBLIC_URL=

# Event → n8n bridge (WS4 §4). The bridge is OFF unless all four are set. N8N_BRIDGE_SECRET must
# match what the event workflows check; only set N8N_WEBHOOK_BASE_URL if n8n is reachable.
N8N_WEBHOOK_BASE_URL=
N8N_BRIDGE_SECRET=
# Comma lists, e.g. org_structure.updated / company,project
# WS11 pipeline needs these three events + streams for the fan-out/delivery workflows to fire:
#   ...,pipeline.run.created,pipeline.gate.decided,scope.signed  /  ...,pipeline_run,pipeline_gate,scope
N8N_BRIDGE_EVENTS=
# ⚠ LEAVING THIS EMPTY DISABLES THE WHOLE BRIDGE. n8nBridgeEnabled() is fail-closed on ALL FOUR of
# webhook base URL + secret + events + entityTypes, so an empty list here means the bridge never
# starts and EVERY event-triggered n8n flow is silently dark (WS11 fan-out + delivery track,
# client.created seeding, org_structure notify) while CRON flows keep working — which is exactly
# how it shipped to gda-aicenter and went unnoticed until 2026-08-03 (0 gates on every run).
# These are the entity_type values the allow-listed events are actually emitted under; note
# scope.signed uses `scope`, NOT `pipeline_run`.
N8N_BRIDGE_ENTITY_TYPES=pipeline_run,pipeline_gate,scope,client,org_structure
# Event → knowledge-graph bridge (WS8 Step E): entity streams whose events populate the KG,
# e.g. client,project,task,deliverable,campaign. Blank = off. Uses KNOWLEDGE_URL/TOKEN.
GRAPH_BRIDGE_ENTITY_TYPES=

# Sync engine (WS1 T2, central role) — optional client-CN allowlist pinned on top of the
# site_subscriptions ACL. Blank = accept any CA-signed node. Idle until a 2nd site is enrolled.
SYNC_ALLOWED_CNS=

# ─────────────────────────────────────────────────────────────────────────────
# WS9 Observability. Bring up the stack with:
#   docker compose -f docker-compose.vps.yml -f docker-compose.observability.yml up -d
#
# OTEL_ENABLED / OTEL_EXPORTER_OTLP_ENDPOINT (WA-hardening D, 2026-07-29): these are now BASE
# defaults baked into docker-compose.vps.yml (every instrumented service reads them straight from
# this .env), NOT only set by the observability.yml overlay. This closes a real incident: a plain
# `docker compose -f docker-compose.vps.yml -f docker-compose.local.yml up -d --build bot` (the
# documented day-to-day dev rebuild command, no observability.yml) silently dropped OTEL_ENABLED the
# moment bot/platform got recreated, and the running Grafana/Prometheus/Tempo stack went blind with
# no error anywhere. Set OTEL_ENABLED=1 here ONCE (after you've brought the observability stack up
# at least once) and it survives every future rebuild regardless of which -f files you pass.
# Fail-soft either way: unset/0 = no-op; set but collector unreachable = telemetry silently dropped,
# never a crash.
#
# OBS-01 follow-up (2026-08-06): OTEL_ENABLED is SHARED by six services (ai-gateway, knowledge,
# mcp-hub, bot, bot-media-worker, and the idle sync-central) plus platform used to read the same
# var. Flipping it on for platform ALONE by editing this line once accidentally restarted
# ai-gateway too (its blast radius is all six). Doing it via a shell-level override on a scoped
# `up -d platform` avoids that, but a later release recreates platform from this file's default
# and silently turns it back off. PLATFORM_OTEL_ENABLED is a SEPARATE var, referenced only in
# platform's own environment: block in docker-compose.vps.yml — set it here to keep platform's
# telemetry on across releases without touching the other five/six services' default.
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PLATFORM_OTEL_ENABLED=1
# ─────────────────────────────────────────────────────────────────────────────
# Grafana admin (REQUIRED to start the observability stack). openssl rand -hex 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# D15 alerting — ≥2 INDEPENDENT transports + a dead-man's-switch. Wire as many as you can:
#   1. Telegram (reuses TELEGRAM_BOT_TOKEN above) — set the numeric chat id to alert:
ALERT_CHAT_ID=
#   2. Email/SMTP:
SMTP_SMARTHOST=            # e.g. smtp.example.com:587
SMTP_FROM=                # e.g. alerts@gaiada.com
SMTP_USERNAME=
SMTP_PASSWORD=
# MAIL-02: Alertmanager's own default is "true" — it flatly refuses a TLS-less smarthost, which
# is deliberate for a real relay. Only the dev-stage Mailpit sink (authless, plaintext, MAIL-00)
# sets this to "false", and it does so in that environment's own .env, not here.
SMTP_REQUIRE_TLS=true
ALERT_EMAIL_TO=           # where alerts land
#   3. Generic webhook (Slack/Discord/custom). Defaults to the self-hosted ntfy topic if blank.
ALERT_WEBHOOK_URL=
#   + External dead-man's-switch (healthchecks.io / Cronitor ping URL). If Prometheus/Alertmanager
#     go dark, the external monitor stops seeing the Watchdog heartbeat and pages out-of-band.
DEADMANSSWITCH_URL=

# DR-burst budget (WS9 D15) — bounded, time-boxed AI-cost burst unlocked ONLY on a declared
# failover (env-declared at boot with DR_MODE=true, or at runtime via POST /admin/dr-mode).
# Extra allowance over the steady GATEWAY_DAILY_CALL_CAP; still capped, so it can't run away.
DR_MODE=false
DR_BURST_CAP=2000
DR_DURATION_MIN=1440

# Admin-console config overrides (gateway PUT /admin/config). The env stays the source of truth at
# boot; a console write records an override here and it is re-applied on the next boot, so a deploy
# doesn't silently revert an operator's change. Lives on the gateway-data volume by default.
# DELETE /admin/config?key= drops an override and hands that key back to the env, live.
# Only the gateway's own allowlist is writable (caps, breaker tuning, provider timeout, DLP toggle,
# chain order) — credentials, EGRESS_ALLOWLIST, GATEWAY_TLS_MODE and topology stay env + restart.
GATEWAY_ADMIN_OVERRIDES_FILE=data/admin-overrides.json

# ── Search-marketing / SEO module (SM-05 driver, SM-06 flags) ─────────────────────────────────
# KEYLESS IS SUPPORTED: leave DATAFORSEO_* blank and the paid driver is not registered — every
# paid search capability fails closed, while the $0 pillars (crawler audits, keyword clustering,
# AI drafts) keep working. Fill these only after the shared DataForSEO deposit is funded.
# ONE server-side credential pair against ONE shared deposit pool — never per-client keys.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# standard (~5 min queue, $0.0006/SERP) | live (immediate, $0.002 — 3.3x). Keep 'standard'.
DATAFORSEO_QUEUE=standard
# "live" (default) registers real vendor drivers per their own credentials. "simulate" registers
# SM-33's synthetic dataforseo/semrush/ahrefs drivers INSTEAD, so dev/staging demos the department at
# $0 real spend without empty tables. Only the exact string "simulate" opts in.
SEARCH_PROVIDER_MODE=live
# SM-48 (tracker §6s): PLATFORM-LEVEL, tenant-agnostic portfolio domains (comma-separated), folded
# into simulate mode's SERP candidate pool ONLY — never read by the live drivers. Fixes "a simulated
# rank-pull always returns position: null" without leaking a tenant's domain into the shared, no-RLS
# search_data_cache (D-4). Unset (default) => today's simulated SERP, byte for byte.
SEARCH_SIMULATION_PORTFOLIO_DOMAINS=
# Semrush Analytics API v3 (SM-34). Empty SEMRUSH_API_KEY => not registered, independently of the
# other two vendors' own credential checks.
SEMRUSH_API_KEY=
SEMRUSH_BASE_URL=https://api.semrush.com
SEMRUSH_DATABASE=us
# Design addendum §A3.3/§A7 OQ-9 (BINDING): UNVERIFIED owner-supplied facts — read off the Semrush
# account console. BOTH must be positive or the driver does NOT register even with the key set (an
# unset rate must never silently become $0 — that would disarm the budget stop-loss).
SEMRUSH_MONTHLY_PLAN_PRICE_USD=
SEMRUSH_MONTHLY_UNIT_ALLOWANCE=
# Ahrefs API v3 (SM-35). Empty AHREFS_API_KEY => not registered, independently of the other two
# vendors' own credential checks. AHREFS_RANK_TRACKER_PROJECT_ID is required for the 'serp'
# capability only (Ahrefs's SERP Overview needs a pre-existing Rank Tracker project); unset refuses
# that one capability cleanly, no network call, no effect on volume/difficulty/backlinks/competitors.
AHREFS_API_KEY=
AHREFS_BASE_URL=https://api.ahrefs.com/v3
AHREFS_COUNTRY=us
AHREFS_RANK_TRACKER_PROJECT_ID=
# Design addendum §A3.3/§A7 OQ-10 (BINDING): UNVERIFIED owner-supplied facts — whether the current
# Ahrefs plan even includes API v3 is unconfirmed; read off the Ahrefs account console. BOTH must be
# positive or the driver does NOT register even with the key set (same B1 rule as Semrush).
AHREFS_MONTHLY_API_TIER_PRICE_USD=
AHREFS_MONTHLY_UNIT_ALLOWANCE=
# Spend stop-loss ceilings. Order: engagement provider_budget_usd (per client, set in the
# console) -> tenant -> global. Leave the tenant cap blank to skip that tier.
SEARCH_GLOBAL_MONTHLY_CAP_USD=150
SEARCH_TENANT_MONTHLY_CAP_USD=
SEARCH_BUDGET_WARN_RATIO=0.8
# Per-pillar kill switches — an incident brake, not a rollout gate. 1 = on, 0 = refuse all paid
# pulls for that pillar platform-wide, ahead of any per-engagement config.
SEARCH_PILLAR_SEO=1
SEARCH_PILLAR_SEM=1
SEARCH_PILLAR_GEO=1

# ── STAGING PREREQUISITES for the search-marketing department (added 2026-08-01, tracker §6bw) ──────
# These were readable by the app and documented in platform-nest/.env.example, but had no passthrough
# in docker-compose.vps.yml — so setting them here did NOTHING. Both sides are now wired. Leaving them
# blank is a supported state: every capability they gate refuses cleanly rather than degrading.
#
# SM-25a/25c — the client-account Google surfaces (Search Console, GA4, Ads read). Per-client OAuth;
# these are OUR app's client credentials, never a client's own tokens (those live encrypted per row).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must byte-match the redirect URI registered in the Google Cloud console, or the flow fails at Google.
GOOGLE_OAUTH_REDIRECT_URI=
# SM-26 — Google Ads API needs an APPROVED developer token; approval is a Google-side review process,
# so this is a lead-time item, not a copy-paste one. LOGIN_CUSTOMER_ID is the MCC the calls act under.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
#
# Two SEPARATE callback secrets, deliberately not one shared value: the first guards a paid-vendor
# postback (DataForSEO -> SM-56's collect edge), the second a script running inside the client's OWN
# Google Ads account (SM-20's search-terms ingest). Different trust boundaries, so one secret would
# mean a compromise of either grants both. UNSET IS FAIL-CLOSED at both edges — every request is
# refused, never waved through. Generate with: openssl rand -hex 32
SEARCH_CALLBACK_SECRET=
SEARCH_SEM_CALLBACK_SECRET=
#
# SM-26 / addendum §A12.6 — whether an approved change proposal is actually PUSHED to a client's live
# ad account. Deliberately independent of SEARCH_PROVIDER_MODE (which governs where DATA comes from),
# because "simulated data" and "simulated ad writes" are different risks — and pushing real ad changes
# derived from synthetic keyword data is FORBIDDEN outright, with no override flag.
# 'simulate' (default, and the default on any typo) never reaches Google. 'live' REFUSES TO BOOT
# without a registered live executor, so a half-finished cutover fails at startup rather than after a
# client's one-shot approval has already been spent.
SEARCH_ADS_WRITE_MODE=simulate
# SM-54 — platform-side pull scheduler, OFF BY DEFAULT. This is a MONEY CONTROL, not a performance
# flag: it answers "does this environment spend vendor money unattended", the one loop with no
# human in the request path. Leave unset outside a deployment with real per-engagement budgets set.
SEARCH_SCHEDULER_ENABLED=
# Due-ness re-ask interval (ms), not pull frequency — cadence still gates spend. Default 3600000
# (1h) if unset; values <=1000 are refused at boot.
SEARCH_SCHEDULER_INTERVAL_MS=

# ─────────────────────────────────────────────────────────────────────────────
# WA operability hardening (2026-07-29, Agent D) — OUT-OF-BAND watchdog, deliberately independent
# of Docker/Prometheus/Alertmanager (it must still report when the whole box is down). Scheduled as
# a Windows Task ("gaiada-wa-watchdog", see infra/runbooks/wa-operations.md). Zero-setup default:
# a local log file (infra/scripts/wa-watchdog.log) + a Windows toast + a Windows Event Log entry —
# no signup, no account, nothing external required. Everything below is OPTIONAL off-box alerting;
# leave blank and the watchdog still works locally.
#   ntfy.sh public topic (pick a hard-to-guess name — anyone who knows it can read your alerts):
WA_WATCHDOG_NTFY_TOPIC=
#   Generic webhook (Slack/Discord/Teams incoming webhook, or your own endpoint):
WA_WATCHDOG_WEBHOOK_URL=
#   Email reuses the SAME SMTP_SMARTHOST/SMTP_FROM/SMTP_USERNAME/SMTP_PASSWORD/ALERT_EMAIL_TO vars
#   the VPS Alertmanager uses above — one place to set SMTP creds, no new vars needed. Blank = off.
#   Also reuses DEADMANSSWITCH_URL above: on a healthy check the watchdog pings it too, an even
#   stronger signal than healthcheck.sh's ping since this one doesn't depend on Docker at all.
# How stale the bot's own ingestion may be (via GET /admin/ingest/health) before the watchdog treats
# it as "silently deaf" — matches the WaIngestionStalled Prometheus rule's threshold for consistency.
WA_WATCHDOG_STALE_MINUTES=15
# The watchdog calls GET /admin/ingest/health using the same BOT_ADMIN_TOKEN/ADMIN_TOKEN set above.
# Blank token = the watchdog skips the stall check and reports "unknown", never false-alarms.

# Ingest proxy timeout. Must exceed real dispatcher latency (AI extraction ~15-23s) or the
# recording never links its pipeline run. See DEF-1.
N8N_BRIDGE_TIMEOUT_MS=30000

# Meeting-recording upload caps (bytes). Audio 200MB / video 500MB; enforced PER KIND in the
# handler because @fastify/multipart registers only ONE fileSize app-wide.
MEETING_AUDIO_MAX_BYTES=209715200
MEETING_VIDEO_MAX_BYTES=524288000

# ASST-06 — assistant send->stream engine tunables (see platform-nest/.env.example for full
# rationale). Reuses GATEWAY_URL/GATEWAY_TOKEN above for the actual gateway calls; these two are
# assistant-specific only. Forwarded to the platform service's environment: block in
# docker-compose.vps.yml — that row is what makes a change here actually reach the container.
ASSISTANT_STREAM_IDLE_TIMEOUT_MS=60000
ASSISTANT_CONTEXT_CHAR_BUDGET=12000

# ── Keycloak ADMIN access (W0-3) — provisions client-portal contact accounts on invite acceptance ──
# FAIL-CLOSED: any of these four unset => every provisioning entry point throws an honest 503 and no
# client contact can be given an account. Nothing half-creates.
#
# The client MUST be a confidential SERVICE-ACCOUNT client holding realm-management:manage-users
# (+ view-users). `gaiada-provisioner` exists on the gaiada realm for exactly this. Do NOT use the
# master-realm admin, and do NOT reuse gaiada-platform (whose audience the API itself trusts) — a
# leaked provisioner secret should be able to manage users and nothing else. Verified boundary: it
# cannot create clients and cannot map realm-admin onto a user it created (both 403).
#
# baseUrl is the realm ROOT with NO /realms suffix. NOTE this deployment serves Keycloak under /idp,
# not /auth: internally http://keycloak:8080/idp.
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_ADMIN_REALM=gaiada
KEYCLOAK_ADMIN_CLIENT_ID=gaiada-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
# App version (docs/modules/VERSIONING.md). /VERSION at the repo root is the single source, and
# deploy.yml passes it to compose after checking the git tag matches. Set it here for a LOCAL
# stack so platform /health and Settings -> About can state what is running; leave it unset and
# they honestly report "unknown" rather than claiming a version this build may not be.
APP_VERSION=

# ── MAIL-00 — Mailpit dev mail sink (design §4.3; profile `mail-dev`) ─────────────────────────
# Dev-stage fake-SMTP sink for the Zone A mail subsystem. Catches everything, sends nothing; no
# vars needed here (Mailpit needs no credentials). The mail module's own MAIL_STREAM_*_RELAY_HOST
# vars already default to `mailpit`/`1025`/empty-creds directly in docker-compose.vps.yml's
# `platform` service (no override needed for the dev-stage sink hop) — see platform-nest/.env.example
# for the full MAIL_* list if you need to change any of it.
# Reach the UI/API over SSH: `ssh -L 8025:localhost:8025 gda-aicenter` then browse
# http://localhost:8025 — it is published loopback-only ON THE BOX (127.0.0.1:8025:8025) and
# must NEVER be made internet-reachable (it will hold live password-reset/magic-link mail).
# Remember to add `mail-dev` to the COMPOSE_PROFILES repo variable, or `deploy.yml`'s
# `--remove-orphans` deletes this container on the next deploy.

# ── MAIL-04 — mail core module master switches (design §4.1/§12) ───────────────────────────────
# Everything else the mail module reads already has a working dev-stage default baked directly
# into docker-compose.vps.yml's `platform` service (both streams -> mailpit:1025, authless). These
# four are the ones an operator on THIS box actually needs to set:
#   MAIL_ENABLED=1                    # flip on once mail-dev is actually up; default 0 (dark)
#   MAIL_WEBHOOK_TOKEN=<random>       # openssl rand -hex 24 — delivery-event webhook auth
#   MAIL_INBOUND_TOKEN=<random>       # openssl rand -hex 24 — inbound-reply intake auth (MAIL-13)
#   MAIL_LINK_BASE_URL=
# ⚠ QUOTE THESE. The `Name <addr>` form contains a space and angle brackets. `docker compose` parses
# this file itself and treats the value as a literal, so an unquoted version looks fine and starts
# fine — but deploy.yml's backup gate SOURCES the same file in bash, where `<addr>` is a redirection.
# On 2026-08-06 an unquoted pair added straight onto the box (never mirrored here) failed the backup
# step and rolled a good release back, reporting only "syntax error near unexpected token `newline'".
# Two consumers, two grammars: quote anything with a space or any of < > | & ; ( ) $ `
MAIL_STREAM_NOTIFY_FROM="Gaiada <no-reply@notify.gaiada.invalid>"
MAIL_STREAM_AUTH_FROM="Gaiada Sign-in <no-reply@auth.gaiada.invalid>"
MAIL_REPLY_DOMAIN=notify.gaiada.invalidhttps://erp.gaiada.online   # THIS box's real public ERP URL — A12: the
#     compiled fallback (https://erp.gaiada.invalid) is deliberately unreachable, so a forgotten
#     override here produces an obviously-dead link in mail, never a live one nobody configured.
MAIL_ENABLED=0
MAIL_WEBHOOK_TOKEN=
MAIL_INBOUND_TOKEN=
MAIL_LINK_BASE_URL=

# ── MAIL-14 — ClamAV attachment scanning (design §7.6; profile `scan`) ─────────────────────────
# First actual instantiation of ClamAV in the estate (previously a webdesk-blueprint pattern
# only). Scans inbound-mail attachments before download; webdesk C-02 uploads will later reuse
# the same service. No vars needed here either — the mail module's MAIL_INBOUND_SCAN=clamav flag
# (MAIL-13/MAIL-04) points platform at this container by its compose DNS name (`clamav`).
# Remember to add `scan` to the COMPOSE_PROFILES repo variable (same orphan-trap reasoning as
# mail-dev above). Absent this service, platform boots fine (fail-soft boot) but attachment
# downloads stay admin-only (fail-closed exposure) until scanning is configured.

# ── SMM-04 — Postiz, the SMM publishing engine (AGPL-3.0, CONTAINED) ──────────────────────────
#
# ⚠⚠ THIS WHOLE BLOCK BELONGS ON A DIFFERENT MACHINE FROM THE REST OF THIS FILE. ⚠⚠
# Everything else in `.env.example` describes `gda-aicenter`'s `.env`. This block describes the
# `.env` of the SumoPod VPS (**150.109.15.108**, user `ubuntu`), where the Postiz stack runs
# after the owner's 2026-08-13 retarget (addendum §A4k/§A4l). Filling these values into
# gda-aicenter's `.env` does NOTHING — no service there names them — and it puts the group's
# platform-app secrets on a box that has no use for them. That is the failure this banner
# exists to prevent; it is the same class as the "a var in .env does nothing unless the
# service's environment: block lists it" trap, one level up.
#
# STATUS: PROTOTYPED, NOT DEPLOYED ANYWHERE. These vars are consumed by
# `docker-compose.social.yml`, a SEPARATE compose project (`gaiada-social`) behind profile
# `social`. It is deliberately NOT part of the release deploy:
#   * do NOT add docker-compose.social.yml to the COMPOSE_FILES repo variable
#   * do NOT add `social` to the COMPOSE_PROFILES repo variable
# Being a separate project is what makes the `gaiada` project's `up -d --remove-orphans`
# structurally unable to delete this stack. Since the retarget it is also on a different host
# entirely, which the release pipeline cannot reach at all — belt and braces, kept both.
#
# Read docs/superpowers/plans/2026-08-13-smm-04-containment-spike.md before starting it. The
# footprint is unchanged by the host move (~3.4 GiB RSS floor, ~7.6 GB day-one disk on a box
# with none of the images resident); what changed is that the target now has 12 GiB available
# and 169 GB free instead of 4.0 GB and 13 GB. See infra/runbooks/deploy-vps.md §"Postiz / SMM"
# for the host-safety rules — that VPS runs 19 containers of the owner's private production.

# Bind address for Postiz's ONLY published port. NEVER 0.0.0.0: Docker's published-port rules
# bypass ufw, so a 0.0.0.0 bind is internet-reachable on a box whose firewall denies incoming.
# Default is loopback so a missing value fails safe. On the VPS this is the WireGuard address.
#   local/dev : 127.0.0.1        VPS deploy : 10.88.0.2
SOCIAL_BIND_ADDR=127.0.0.1
#
# URL trio. Load-bearing: Postiz builds each network's OAuth redirect_uri as
# `${FRONTEND_URL}/integrations/social/<provider>` and replays that exact string in the token
# exchange, so changing it later invalidates every already-connected account. See the spike
# report §7 — this SHOULD point at a path platform-ui serves, so Postiz's own frontend is
# never exposed to a browser.
SOCIAL_POSTIZ_MAIN_URL=
SOCIAL_POSTIZ_FRONTEND_URL=
SOCIAL_POSTIZ_BACKEND_URL=
# openssl rand -hex 32 for each of these three.
SOCIAL_POSTIZ_JWT_SECRET=
SOCIAL_POSTIZ_DB_PASSWORD=
SOCIAL_TEMPORAL_DB_PASSWORD=
# Loopback-only published port for the engine. nginx reaches it here; nothing else may.
SOCIAL_POSTIZ_PORT=4007
# Containment invariant. Keep `true`. Bootstrap needs it false EXACTLY ONCE to create the first
# org (see the runbook), then it goes back to true BEFORE the edge is opened. Verified by
# SMM-04: with it true, POST /api/auth/register returns 400 "Registration is disabled".
SOCIAL_POSTIZ_DISABLE_REGISTRATION=true
SOCIAL_POSTIZ_API_LIMIT=30
# Platform-app credentials — the GROUP's own app secrets (design §11 custody split (a)).
# These live here and nowhere else: never per-tenant rows, never n8n credentials, never the
# browser. Client network tokens are minted and held INSIDE Postiz and are never copied out.
# All four app reviews are in flight (addendum OQ-1); leave blank until each is granted.
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_ID=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
# X/Twitter is the one METERED network and ships DISABLED in every scope (OQ-2 / D-14) — a $0
# publish path is what keeps social.publishPost eligible for the D14 executable-approval
# registry. There is deliberately no X var here; the compose file hardcodes those keys empty.

# ── SMM-05 — the ERP side of the cross-host hop. THESE TWO GO ON `gda-aicenter`. ──────────────
# Everything above this line belongs on the VPS. These two belong here, on the ERP box, and are
# the whole of what `platform-nest`'s SocialPublisher adapter needs to reach the engine. Named
# now, by the integrator, so SMM-05 implements a contract rather than inventing one — a rename
# later is a two-host coordinated edit, which is exactly the kind of change that goes stale on
# one side and fails at 3am.
#
# The base URL is the WireGuard peer address, NOT a public hostname and NOT https. There is no
# public listener on the VPS to point a hostname at, and the confidentiality/integrity that
# https would provide is already supplied by the tunnel (ChaCha20-Poly1305, mutual key auth) —
# a level below, and with the peer authenticated by KEY rather than by source address. If the
# tunnel is down this fails closed with a connection error, which is the correct behaviour and
# is loud. Do NOT "fix" a tunnel outage by pointing this at a public address.
SOCIAL_POSTIZ_BASE_URL=http://10.88.0.2:4007
# The Postiz ORG API key (design §11 custody split (b)). Server-side only: it is read from the
# platform container's env, sent as an Authorization header on each adapter call, and never
# reaches platform-ui, n8n credentials, a tenant row, an audit line or a log field. It now also
# travels over the wire on every call — inside the tunnel, never on the open internet. Rotating
# it is a two-host edit: mint in Postiz on the VPS, set here, recreate the platform container.
SOCIAL_POSTIZ_ORG_API_KEY=
