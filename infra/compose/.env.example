# Copy to .env next to docker-compose.vps.yml and fill in (openssl rand -hex 16 for tokens).

# Release pinning — every first-party service runs the SIGNED GHCR image for this tag; the box
# never compiles (docs/blueprints/deployment-strategy.md). CI sets these per deploy; set them
# here only for manual/break-glass runs. Use docker-compose.build.yml to build from source.
GAIADA_TAG=latest
GHCR_OWNER=hansel-gaiada

# Postgres — one superuser + per-service owner(migrator) & runtime roles (DB topology plan
# 2026-07-15). Each service connects as its restricted *_app role; migrations run as *_owner.
POSTGRES_SUPER_PASSWORD=
PLATFORM_OWNER_PASSWORD=
PLATFORM_APP_PASSWORD=
SYNC_APP_PASSWORD=
KNOWLEDGE_OWNER_PASSWORD=
KNOWLEDGE_APP_PASSWORD=
# Third-party self-managed DBs on the core instance (Keycloak, n8n).
KEYCLOAK_DB_PASSWORD=
N8N_DB_PASSWORD=
# Bot roles — used by the ISOLATED pg-bot instance (its PII/crypto-shred store).
BOT_OWNER_PASSWORD=
BOT_APP_PASSWORD=

# Bot <-> WAHA webhook shared secret (fail-closed)
WEBHOOK_SECRET=
# WAHA REST API key + dashboard password
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=

# AI Gateway (the ONLY holder of provider keys)
GATEWAY_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Local model server on the VPS (blank = disabled; cloud/echo only)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# OpenAI-compatible cloud brain (e.g. Ollama Cloud). Set BASE_URL+API_KEY to route text-completion
# through it first (LLM_CHAIN below). Blank = disabled, chain falls through to ollama/gemini/claude.
#   OPENAI_BASE_URL=https://ollama.com/v1
#   OPENAI_MODEL=deepseek-v4-flash   # returns clean content; glm-5.2/kimi-k2.7-code are reasoning
#                                    # models that need a large OPENAI_MAX_TOKENS or reply empty.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
# Vision model for image media (image/* only; audio/PDF fail over to whisper/gemini). On Ollama
# Cloud qwen3.5 accepts images, glm-5.2 does not. Leave blank to disable openai image handling.
OPENAI_VISION_MODEL=qwen3.5:397b
OPENAI_MAX_TOKENS=1024
# Provider order for text completion + media. Leave default to prefer the OpenAI-compatible brain,
# then local Ollama / whisper, then cloud. Unset providers are auto-skipped.
LLM_CHAIN=openai,ollama,gemini,claude
MEDIA_CHAIN=openai,whisper,gemini
GATEWAY_DAILY_CALL_CAP=2000

# Gateway daily-call cap already above. Whisper transcription model + model-assisted DLP:
WHISPER_MODEL=Systran/faster-whisper-small
# Local-Ollama DLP classifier — enable ONLY where OLLAMA_URL is reachable (else it 503s /complete).
DLP_CLASSIFIER_ENABLED=false

# MCP hub service token
HUB_SERVICE_TOKEN=

# Platform service token (surfaces/hub present this to the platform API)
PLATFORM_SERVICE_TOKEN=

# Knowledge service token (WS8 derived store)
KNOWLEDGE_SERVICE_TOKEN=

# Agent runner service token (WS8 goal queue; openssl rand -hex 16)
AGENT_RUNNER_TOKEN=

# Platform-UI session cookie secret (REQUIRED — compose aborts if unset). openssl rand -hex 32
UI_SESSION_SECRET=

# report-renderer sidecar (TR-19, tracker/reporting §6.3) — the only image in the estate carrying
# Chromium. openssl rand -hex 16. Shared bearer token; never logged, never given to platform-ui.
RENDERER_TOKEN=
# Origin this sidecar is allowed to render (SSRF guard — see report-renderer/src/auth.ts). Must
# match platform-ui's internal, network-reachable origin; default matches the compose service name.
PLATFORM_UI_INTERNAL_URL=http://platform-ui:3005

# Keycloak admin (5b) + platform auth mode (dev until the realm+MFA are set up, then oidc)
KEYCLOAK_ADMIN_PASSWORD=
PLATFORM_AUTH_MODE=dev

# Telegram (long-polling; leave empty to disable)
TELEGRAM_BOT_TOKEN=

# Bot admin routes (blank = disabled) + digest delivery
ADMIN_TOKEN=
MANAGEMENT_GROUP_ID=
POST_TO_GROUPS=false
# Note: the group registry (groups.yaml) now lives in the bot-data volume after first boot,
# seeded from the committed ./groups.yaml file. See compose env GROUPS_FILE / GROUPS_SEED_FILE.
# Media worker concurrency (per-worker parallel media jobs)
MEDIA_WORKER_CONCURRENCY=2

# Admin/Systems console → bot admin probe. Set to the bot's ADMIN_TOKEN above to enable it.
BOT_ADMIN_TOKEN=

# Automation (the separate gaiada-automation n8n stack). Set only if n8n is reachable from
# this compose network. AUTOMATION_API_KEY is an n8n Public-API key → the Systems→Automation
# console lists real workflows + last-run.
AUTOMATION_URL=
AUTOMATION_API_KEY=

# Event → n8n bridge (WS4 §4). The bridge is OFF unless all four are set. N8N_BRIDGE_SECRET must
# match what the event workflows check; only set N8N_WEBHOOK_BASE_URL if n8n is reachable.
N8N_WEBHOOK_BASE_URL=
N8N_BRIDGE_SECRET=
# Comma lists, e.g. org_structure.updated / company,project
# WS11 pipeline needs these three events + streams for the fan-out/delivery workflows to fire:
#   ...,pipeline.run.created,pipeline.gate.decided,scope.signed  /  ...,pipeline_run,pipeline_gate,scope
N8N_BRIDGE_EVENTS=
N8N_BRIDGE_ENTITY_TYPES=
# Event → knowledge-graph bridge (WS8 Step E): entity streams whose events populate the KG,
# e.g. client,project,task,deliverable,campaign. Blank = off. Uses KNOWLEDGE_URL/TOKEN.
GRAPH_BRIDGE_ENTITY_TYPES=

# Sync engine (WS1 T2, central role) — optional client-CN allowlist pinned on top of the
# site_subscriptions ACL. Blank = accept any CA-signed node. Idle until a 2nd site is enrolled.
SYNC_ALLOWED_CNS=

# ─────────────────────────────────────────────────────────────────────────────
# WS9 Observability. Bring up the stack with:
#   docker compose -f docker-compose.vps.yml -f docker-compose.observability.yml up -d
#
# OTEL_ENABLED / OTEL_EXPORTER_OTLP_ENDPOINT (WA-hardening D, 2026-07-29): these are now BASE
# defaults baked into docker-compose.vps.yml (every instrumented service reads them straight from
# this .env), NOT only set by the observability.yml overlay. This closes a real incident: a plain
# `docker compose -f docker-compose.vps.yml -f docker-compose.local.yml up -d --build bot` (the
# documented day-to-day dev rebuild command, no observability.yml) silently dropped OTEL_ENABLED the
# moment bot/platform got recreated, and the running Grafana/Prometheus/Tempo stack went blind with
# no error anywhere. Set OTEL_ENABLED=1 here ONCE (after you've brought the observability stack up
# at least once) and it survives every future rebuild regardless of which -f files you pass.
# Fail-soft either way: unset/0 = no-op; set but collector unreachable = telemetry silently dropped,
# never a crash.
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# ─────────────────────────────────────────────────────────────────────────────
# Grafana admin (REQUIRED to start the observability stack). openssl rand -hex 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# D15 alerting — ≥2 INDEPENDENT transports + a dead-man's-switch. Wire as many as you can:
#   1. Telegram (reuses TELEGRAM_BOT_TOKEN above) — set the numeric chat id to alert:
ALERT_CHAT_ID=
#   2. Email/SMTP:
SMTP_SMARTHOST=            # e.g. smtp.example.com:587
SMTP_FROM=                # e.g. alerts@gaiada.com
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=           # where alerts land
#   3. Generic webhook (Slack/Discord/custom). Defaults to the self-hosted ntfy topic if blank.
ALERT_WEBHOOK_URL=
#   + External dead-man's-switch (healthchecks.io / Cronitor ping URL). If Prometheus/Alertmanager
#     go dark, the external monitor stops seeing the Watchdog heartbeat and pages out-of-band.
DEADMANSSWITCH_URL=

# DR-burst budget (WS9 D15) — bounded, time-boxed AI-cost burst unlocked ONLY on a declared
# failover (env-declared at boot with DR_MODE=true, or at runtime via POST /admin/dr-mode).
# Extra allowance over the steady GATEWAY_DAILY_CALL_CAP; still capped, so it can't run away.
DR_MODE=false
DR_BURST_CAP=2000
DR_DURATION_MIN=1440

# Admin-console config overrides (gateway PUT /admin/config). The env stays the source of truth at
# boot; a console write records an override here and it is re-applied on the next boot, so a deploy
# doesn't silently revert an operator's change. Lives on the gateway-data volume by default.
# DELETE /admin/config?key= drops an override and hands that key back to the env, live.
# Only the gateway's own allowlist is writable (caps, breaker tuning, provider timeout, DLP toggle,
# chain order) — credentials, EGRESS_ALLOWLIST, GATEWAY_TLS_MODE and topology stay env + restart.
GATEWAY_ADMIN_OVERRIDES_FILE=data/admin-overrides.json

# ── Search-marketing / SEO module (SM-05 driver, SM-06 flags) ─────────────────────────────────
# KEYLESS IS SUPPORTED: leave DATAFORSEO_* blank and the paid driver is not registered — every
# paid search capability fails closed, while the $0 pillars (crawler audits, keyword clustering,
# AI drafts) keep working. Fill these only after the shared DataForSEO deposit is funded.
# ONE server-side credential pair against ONE shared deposit pool — never per-client keys.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# standard (~5 min queue, $0.0006/SERP) | live (immediate, $0.002 — 3.3x). Keep 'standard'.
DATAFORSEO_QUEUE=standard
# "live" (default) registers real vendor drivers per their own credentials. "simulate" registers
# SM-33's synthetic dataforseo/semrush/ahrefs drivers INSTEAD, so dev/staging demos the department at
# $0 real spend without empty tables. Only the exact string "simulate" opts in.
SEARCH_PROVIDER_MODE=live
# SM-48 (tracker §6s): PLATFORM-LEVEL, tenant-agnostic portfolio domains (comma-separated), folded
# into simulate mode's SERP candidate pool ONLY — never read by the live drivers. Fixes "a simulated
# rank-pull always returns position: null" without leaking a tenant's domain into the shared, no-RLS
# search_data_cache (D-4). Unset (default) => today's simulated SERP, byte for byte.
SEARCH_SIMULATION_PORTFOLIO_DOMAINS=
# Semrush Analytics API v3 (SM-34). Empty SEMRUSH_API_KEY => not registered, independently of the
# other two vendors' own credential checks.
SEMRUSH_API_KEY=
SEMRUSH_BASE_URL=https://api.semrush.com
SEMRUSH_DATABASE=us
# Design addendum §A3.3/§A7 OQ-9 (BINDING): UNVERIFIED owner-supplied facts — read off the Semrush
# account console. BOTH must be positive or the driver does NOT register even with the key set (an
# unset rate must never silently become $0 — that would disarm the budget stop-loss).
SEMRUSH_MONTHLY_PLAN_PRICE_USD=
SEMRUSH_MONTHLY_UNIT_ALLOWANCE=
# Ahrefs API v3 (SM-35). Empty AHREFS_API_KEY => not registered, independently of the other two
# vendors' own credential checks. AHREFS_RANK_TRACKER_PROJECT_ID is required for the 'serp'
# capability only (Ahrefs's SERP Overview needs a pre-existing Rank Tracker project); unset refuses
# that one capability cleanly, no network call, no effect on volume/difficulty/backlinks/competitors.
AHREFS_API_KEY=
AHREFS_BASE_URL=https://api.ahrefs.com/v3
AHREFS_COUNTRY=us
AHREFS_RANK_TRACKER_PROJECT_ID=
# Design addendum §A3.3/§A7 OQ-10 (BINDING): UNVERIFIED owner-supplied facts — whether the current
# Ahrefs plan even includes API v3 is unconfirmed; read off the Ahrefs account console. BOTH must be
# positive or the driver does NOT register even with the key set (same B1 rule as Semrush).
AHREFS_MONTHLY_API_TIER_PRICE_USD=
AHREFS_MONTHLY_UNIT_ALLOWANCE=
# Spend stop-loss ceilings. Order: engagement provider_budget_usd (per client, set in the
# console) -> tenant -> global. Leave the tenant cap blank to skip that tier.
SEARCH_GLOBAL_MONTHLY_CAP_USD=150
SEARCH_TENANT_MONTHLY_CAP_USD=
SEARCH_BUDGET_WARN_RATIO=0.8
# Per-pillar kill switches — an incident brake, not a rollout gate. 1 = on, 0 = refuse all paid
# pulls for that pillar platform-wide, ahead of any per-engagement config.
SEARCH_PILLAR_SEO=1
SEARCH_PILLAR_SEM=1
SEARCH_PILLAR_GEO=1
# SM-54 — platform-side pull scheduler, OFF BY DEFAULT. This is a MONEY CONTROL, not a performance
# flag: it answers "does this environment spend vendor money unattended", the one loop with no
# human in the request path. Leave unset outside a deployment with real per-engagement budgets set.
SEARCH_SCHEDULER_ENABLED=
# Due-ness re-ask interval (ms), not pull frequency — cadence still gates spend. Default 3600000
# (1h) if unset; values <=1000 are refused at boot.
SEARCH_SCHEDULER_INTERVAL_MS=

# ─────────────────────────────────────────────────────────────────────────────
# WA operability hardening (2026-07-29, Agent D) — OUT-OF-BAND watchdog, deliberately independent
# of Docker/Prometheus/Alertmanager (it must still report when the whole box is down). Scheduled as
# a Windows Task ("gaiada-wa-watchdog", see infra/runbooks/wa-operations.md). Zero-setup default:
# a local log file (infra/scripts/wa-watchdog.log) + a Windows toast + a Windows Event Log entry —
# no signup, no account, nothing external required. Everything below is OPTIONAL off-box alerting;
# leave blank and the watchdog still works locally.
#   ntfy.sh public topic (pick a hard-to-guess name — anyone who knows it can read your alerts):
WA_WATCHDOG_NTFY_TOPIC=
#   Generic webhook (Slack/Discord/Teams incoming webhook, or your own endpoint):
WA_WATCHDOG_WEBHOOK_URL=
#   Email reuses the SAME SMTP_SMARTHOST/SMTP_FROM/SMTP_USERNAME/SMTP_PASSWORD/ALERT_EMAIL_TO vars
#   the VPS Alertmanager uses above — one place to set SMTP creds, no new vars needed. Blank = off.
#   Also reuses DEADMANSSWITCH_URL above: on a healthy check the watchdog pings it too, an even
#   stronger signal than healthcheck.sh's ping since this one doesn't depend on Docker at all.
# How stale the bot's own ingestion may be (via GET /admin/ingest/health) before the watchdog treats
# it as "silently deaf" — matches the WaIngestionStalled Prometheus rule's threshold for consistency.
WA_WATCHDOG_STALE_MINUTES=15
# The watchdog calls GET /admin/ingest/health using the same BOT_ADMIN_TOKEN/ADMIN_TOKEN set above.
# Blank token = the watchdog skips the stall check and reports "unknown", never false-alarms.

# Ingest proxy timeout. Must exceed real dispatcher latency (AI extraction ~15-23s) or the
# recording never links its pipeline run. See DEF-1.
N8N_BRIDGE_TIMEOUT_MS=30000
