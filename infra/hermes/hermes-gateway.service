# Gateway-contract shim: makes the local Hermes agent the brain of the gaiada stack.
# Runs AS azlan because it shells out to `hermes`, which needs azlan's HOME (/opt/hermes-zen is
# 0700 azlan) and ~/.local/bin on PATH. The shim code itself is ours and lives outside that tree.
#
# ai-gateway (site topology) forwards /complete and /media here via GATEWAY_CENTRAL_URL.
[Unit]
Description=gaiada hermes-gateway shim (Hermes as the stack brain)
Documentation=file:///opt/hermes-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azlan
Group=azlan
WorkingDirectory=/opt/hermes-gateway

# Must bind beyond loopback: containers reach the host as 172.17.0.1 (the docker0 bridge), so a
# 127.0.0.1 bind gives them "connection refused" and ai-gateway silently degrades to its `echo`
# terminator -- a working-looking stack that answers nothing. Same treatment as the host Postgres,
# Redis and Ollama. Safe because the shim is fail-closed on a bearer token (verified: 401 without
# one) and the GCP firewall admits only 22/80/443, so :3009 is never externally reachable.
Environment=HOST=0.0.0.0
Environment=PORT=3009
Environment=HOME=/home/azlan
# REQUIRED. Hermes' real state (provider config, skills, memory, credentials) lives in
# /opt/hermes-zen, not ~/.hermes — azlan's interactive shell exports this. Without it a systemd
# run silently falls back to the empty ~/.hermes and every completion fails with
# "No inference provider configured", which reads like a broken install rather than a missing var.
Environment=HERMES_HOME=/opt/hermes-zen
# System node (apt nodejs 18.x), NOT azlan's nvm build. The shim is our service; pinning it to
# another account's nvm would break it silently the day azlan changes node versions. `hermes`
# itself still comes from azlan's ~/.local/bin (a symlink into /opt/hermes-zen's venv).
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/azlan/.local/bin
# Isolated scratch dir so Hermes' tool use never touches the repo or /opt/hermes-zen.
Environment=HERMES_CWD=/opt/hermes-gateway/work
# Agent runs are slow (full tool/memory loop, not a raw completion).
Environment=HERMES_TIMEOUT_MS=240000
Environment=HERMES_MEDIA_TIMEOUT_MS=600000
# GATEWAY_TOKEN — must equal ai-gateway's. Kept out of this file so the unit is committable.
EnvironmentFile=/etc/gaiada/hermes-gateway.env

ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5s

# The shim only needs to run hermes and write its scratch dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/hermes-gateway/work /home/azlan/.hermes

[Install]
WantedBy=multi-user.target
