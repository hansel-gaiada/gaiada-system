# Copy to .env on sumopod (chmod 600). Never commit the filled file. The repo is PUBLIC.
# Generate every secret on the box:  openssl rand -hex 32   (hex only: the DB password is embedded in a URL)

# Postgres password for the `umami` role (hex, so it is URL-safe).
UMAMI_DB_PASSWORD=
# Signs Umami's auth tokens and the collector's cache token. Rotating it logs everyone out; after any
# rotation re-check that the ERP's API key still authenticates (runbook "Verify").
APP_SECRET=
# Required by Umami 3.x for two-factor auth. 64 hex chars:  openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# Neutral first-party names (verified in Umami 3.4.0's next.config.ts + scripts/update-tracker.js):
#   TRACKER_SCRIPT_NAME  renames the tracker script (rewritten to /script.js). Umami accepts a comma list;
#                        the nginx edge and the Traefik route serve exactly ONE, so keep one.
#   COLLECT_API_ENDPOINT renames the event endpoint (rewritten to /api/send; the tracker file is patched at start).
# MUST equal the paths in traefik-erp-insights.yml. Change all three places together or not at all.
TRACKER_SCRIPT_NAME=/lib/kestrel.js
COLLECT_API_ENDPOINT=/lib/kestrel/e

# Fixed in docker-compose.yml, listed so nobody turns them back on:
#   DISABLE_TELEMETRY=1  DISABLE_UPDATES=1  SALT_ROTATION=day  SKIP_LOCATION_HEADERS=1
#   CLIENT_IP_HEADER=x-real-ip  GEOLITE_DB_PATH=/geo/dbip-city-lite.mmdb

# Optional overrides (defaults shown).
# UMAMI_PUBLISH_PORT=18742        # edge, bound to 172.17.0.1 only
# UMAMI_ADMIN_PORT=13000          # admin-gate profile, bound to 127.0.0.1 only
# UMAMI_WG_BIND=10.88.0.2         # read-gate profile: sumopod's wg0 address
# UMAMI_READ_PORT=18743           # read-gate profile
