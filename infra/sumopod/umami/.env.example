# Copy to .env on sumopod (chmod 600). Never commit the filled file. The repo is PUBLIC.
# Generate every secret on the box:  openssl rand -hex 32   (hex only: the DB password is embedded in a URL)

# Postgres password for the `umami` role (hex, so it is URL-safe).
UMAMI_DB_PASSWORD=
# Signs Umami's auth tokens and the collector's cache token. Rotating it logs everyone out; after any
# rotation re-check that the ERP's API key still authenticates (runbook "Verify").
APP_SECRET=
# Required by Umami 3.x for two-factor auth. 64 hex chars:  openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# Neutral first-party names (verified in Umami 3.4.0's next.config.ts + scripts/update-tracker.js):
#   TRACKER_SCRIPT_NAME  renames the tracker script (rewritten to /script.js). Umami accepts a comma list;
#                        the nginx edge and the erp-edge route serve exactly ONE, so keep one.
#   COLLECT_API_ENDPOINT renames the event endpoint (rewritten to /api/send; the tracker file is patched at start).
# MUST equal the paths in erp-edge/dynamic/erp-insights.yml. Change all three places together or not at all.
TRACKER_SCRIPT_NAME=/lib/kestrel.js
COLLECT_API_ENDPOINT=/lib/kestrel/e

# The ONE address the edge trusts to state the visitor's address (X-Forwarded-For), as nginx sees erp-edge's
# connections. A single IP or CIDR, never a docker-wide range. Measure it on the box (runbook "Which source does
# the edge see"); it is usually the gateway of this project's `edge` bridge (10.211.91.1) because the
# erp-edge -> 172.17.0.1:18742 hop is masqueraded. No default: compose refuses to start without it.
ERP_EDGE_SOURCE=

# ---- M5-V2-c: enrichment collector + its database (vdb) -------------------------------------------------------
# Postgres password for the `vdb` role (hex, URL-safe, DIFFERENT from UMAMI_DB_PASSWORD):  openssl rand -hex 32
VDB_PASSWORD=
# Comma-separated Umami website ids the collector accepts (a hit for any other id is 403). Empty refuses to start.
# The id exists only after runbook step 7 (admin); until then use a well-formed placeholder UUID, e.g.
# 00000000-0000-0000-0000-000000000000, and replace it with the real id (then `docker compose up -d collector`).
INSIGHTS_WEBSITES=
# SHA-256 (64 hex) of the ERP's READ key. The collector holds only the hash; the key itself goes to platform-nest
# (INSIGHTS_READ_KEY) and nowhere else. Generate on the box (the key is shown once, never stored here):
#   K=$(openssl rand -hex 32); printf '%s' "$K" | sha256sum | cut -d' ' -f1     # the hash goes below, $K to the orchestrator
OPS_READ_KEY_SHA256=
# M5-V3-b: SHA-256 of the FORGET key, same recipe, a DIFFERENT key (the collector refuses equal hashes). Required.
# The key itself goes to platform-nest (INSIGHTS_FORGET_KEY) and nowhere else. Runbook umami-sumopod.md step C2 (generate) and C7 (use).
OPS_FORGET_KEY_SHA256=

# Switch Umami to the collector's geo headers ONLY after V2-d proves them (design D2): set it EMPTY (not 0).
# Unset = 1 (Umami ignores location headers). Rollback = 1.
# UMAMI_SKIP_LOCATION_HEADERS=1
# Where the edge sends the collect path. Default collector:8080. ROLLBACK: app:3000 (then also UMAMI_SKIP_LOCATION_HEADERS=1).
# EDGE_COLLECT_UPSTREAM=collector:8080
# Collector knobs, all optional; EMPTY or unset = the collector's own default (never 0). Ranges are in insights-collector/CLAUDE.md.
# COLLECTOR_UMAMI_TIMEOUT_MS=3000
# COLLECTOR_MAX_BODY_BYTES=32768
# COLLECTOR_BOT_FLUSH_SECONDS=30
# COLLECTOR_GEO_REQUIRED=1            # exactly 1 = refuse to start without both geo files (recommended live)
# COLLECTOR_FORWARD_IP_MODE=pseudonym # `real` only as the recorded D2 fallback
# COLLECTOR_COMPANY_RESOLVER=network-only
# COLLECTOR_LOG_LEVEL=info
# M5-V3-b, the consented channel (empty = the collector's default):
# COLLECTOR_CONSENT_EVENT_NAMES=       # comma-separated; MUST match the site's event names (V3-j), the default is an assumption
# COLLECTOR_CONSENT_RATE_PER_SECOND=
# COLLECTOR_BUFFER_RETENTION_HOURS=72  # 1..72; the design's buffer is 72 h
# COLLECTOR_PURGE_INTERVAL_MINUTES=
# M5-V6-a, session replay (OFF unless exactly 1; also needs the edge /lib/kestrel/r location and its erp-edge route):
# COLLECTOR_REPLAY_ENABLED=
# COLLECTOR_REPLAY_BUDGET_MB=2048
# COLLECTOR_REPLAY_RETENTION_DAYS=30        # 1..30
# COLLECTOR_REPLAY_SITE_DAILY_RECORDINGS=500
# COLLECTOR_REPLAY_VISITOR_DAILY_RECORDINGS=10

# Fixed in docker-compose.yml, listed so nobody turns them back on:
#   DISABLE_TELEMETRY=1  DISABLE_UPDATES=1  SALT_ROTATION=day  SKIP_LOCATION_HEADERS=1
#   CLIENT_IP_HEADER=x-real-ip  GEOLITE_DB_PATH=/geo/dbip-city-lite.mmdb
#   collector: LISTEN_ADDR=:8080 OPS_ADDR=:8081 UMAMI_URL=http://app:3000 GEO_DIR=/geo (city + ASN file names)

# Optional overrides (defaults shown).
# UMAMI_PUBLISH_PORT=18742        # edge, bound to 172.17.0.1 only
# UMAMI_ADMIN_PORT=13000          # admin-gate profile, bound to 127.0.0.1 only
# UMAMI_WG_BIND=10.88.0.2         # read-gate profile: sumopod's wg0 address
# UMAMI_READ_PORT=18743           # read-gate profile
