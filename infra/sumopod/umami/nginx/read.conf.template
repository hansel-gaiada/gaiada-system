# ERP read gate (profile `erp-read`): a GET-only subset of Umami's API for the read-only user's API key
# (`Authorization: Bearer umami_...`). Reached over WireGuard from gda-aicenter only. Login, user, admin, 2FA
# and API-key management paths are not served (Umami also refuses them for API keys).
#
# M5-V3-c: the same door also carries the collector's ops API (collector:8081) for the ERP: GET /ops/v1/events and
# GET /ops/v1/bots (the READ key), POST /ops/v1/forget (the FORGET key). The Authorization header is passed through
# untouched and the COLLECTOR decides (401 no key, 403 wrong key for the route); this gate only restricts source
# (WireGuard bind), path and method. Any other method or path is refused here. The ops API is NOT on the public
# edge, so publicly /ops/v1/* is a 404.
upstream umami_app {
  server app:3000;
  keepalive 4;
}

# Docker's embedded DNS: the collector is resolved per request (variable in proxy_pass), so this gate starts and
# keeps serving Umami reads even while the collector is down or restarting.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 8080 default_server;
  server_name _;
  client_max_body_size 4k;

  location ~ ^/api/(websites|me|teams)(/|$) {
    limit_except GET { deny all; }
    proxy_pass http://umami_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Cookie "";
    proxy_read_timeout 60s;
  }

  location = /ops/v1/events {
    limit_except GET { deny all; }
    set $collector_ops "collector:8081";
    proxy_pass http://$collector_ops;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Cookie "";
    proxy_read_timeout 60s;
  }

  location = /ops/v1/bots {
    limit_except GET { deny all; }
    set $collector_ops "collector:8081";
    proxy_pass http://$collector_ops;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Cookie "";
    proxy_read_timeout 30s;
  }

  # Forget: POST only (no GET, no DELETE). The body is {website, visitorIds<=100, consentIds<=100, mode}: ~8 KB at most.
  location = /ops/v1/forget {
    limit_except POST { deny all; }
    client_max_body_size 16k;
    set $collector_ops "collector:8081";
    proxy_pass http://$collector_ops;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Cookie "";
    proxy_read_timeout 30s;
  }

  location = /api/heartbeat {
    limit_except GET { deny all; }
    proxy_pass http://umami_app;
  }

  location / { return 404; }
}
