        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "probe_duration_seconds{job=\"client-properties\", internal=~\"$internal\", property_domain=~\"$domain\"}",
          "instant": true,
