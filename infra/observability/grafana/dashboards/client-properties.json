        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "probe_http_status_code{job=\"client-properties\", internal=~\"$internal\", property_domain=~\"$domain\"}",
          "instant": true,
          "range": false,
