{
  "uid": "client-properties",
  "title": "Client Properties",
  "tags": [
    "gaiada",
    "client-properties",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "MON-04. Uptime, response time and TLS expiry of consented client properties, from MON-01 blackbox probes (job client-properties).",
  "templating": {
    "list": [
      {
        "name": "internal",
        "label": "Internal",
        "type": "custom",
        "query": "false,true",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "false",
          "value": "false"
        },
        "options": [
          {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": true,
            "text": "false",
            "value": "false"
          },
          {
            "selected": false,
            "text": "true",
            "value": "true"
          }
        ]
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(probe_success{job=\"client-properties\", internal=~\"$internal\"}, property_domain)",
          "refId": "domain"
        },
        "definition": "label_values(probe_success{job=\"client-properties\", internal=~\"$internal\"}, property_domain)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Properties probed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Verified, active, non-deleted properties in the current filter.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "count(probe_success{job=\"client-properties\", internal=~\"$internal\", property_domain=~\"$domain\"}) or vector(0)",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Up now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "count(probe_success{job=\"client-properties\", internal=~\"$internal\", property_domain=~\"$domain\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Down now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
