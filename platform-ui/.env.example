# Platform API (the ONLY backend this UI talks to)
PLATFORM_URL=http://localhost:3004
PLATFORM_SERVICE_TOKEN=dev-svc-token
# HMAC key for the session cookie (any long random string in dev)
SESSION_SECRET=change-me-long-random

# ORG-13 — shared-service ("Connect service") UI: Connect-service button,
# ServicedBlock, company-switcher served badges, /admin/services. Mirrors the
# backend's own SERVICE_ASSIGNMENTS_ENABLED flag (default OFF) — every write
# 409s on the backend while off, and this UI flag keeps the surfaces hidden
# rather than showing something that would just error. Flip both together.
SERVICE_ASSIGNMENTS_ENABLED=0

# TR-20 — DEV/TEST ONLY. When "1", the print route (`/print/reports/[jobToken]`) resolves its
# document from a labeled local fixture (lib/reports-print-stub.ts) instead of platform-nest's real
# `/internal/reports/print-payload/:jobToken` (TR-21, not built yet). Leave unset/"0" everywhere else
# — a real deploy must always hit the real one-shot-token endpoint. Try tokens
# stub-{person,project,department,company}-{sealed,unsealed} (sealed only defined for person/company).
PRINT_STUB=0

# AD-11 — agency discovery intake. The standalone prospect-facing discovery form's own address
# (design §9.1: its hosting is a separate deployment, not this app). When set, the invite action
# builds `<AGENCY_DISCOVERY_FORM_URL>#t=<token>` — the token in the URL FRAGMENT, never `?t=`. Left
# unset, the invite UI shows the bare one-time token with instructions instead of a broken link.
AGENCY_DISCOVERY_FORM_URL=
